{% extends '@EMSCore/base.html.twig' %}



{% block pagetitle %}Test{% endblock %}

{% block body %}
    <ul>
    {%  for user in test %}
        <span>
            <li>{{ user.name }}</li>
            <button>affiche email</button>
        </span>
    {% endfor %}
    </ul>

    {{ form_start(form, {'method': 'post', 'action': path('emsco_user_add') }) }}
    <div class="box-body">
        <div class="col-md-6">
            {{ form_row(form.username) }}
            {{ form_row(form.displayName) }}
            {{ form_row(form.plainPassword) }}
            {{ form_row(form.locale) }}
            {{ form_row(form.localePreferred) }}
            {{ form_row(form.email) }}
            {{ form_row(form.emailNotification) }}
            {{ form_row(form.enabled) }}
            {% if form.circles is defined %}
                {{ form_row(form.circles) }}
            {% endif %}
            {{ form_row(form.wysiwygProfile) }}
            {{ form_row(form.expirationDate) }}
        </div>

    </div>
    <div class="box-footer">
        {{ form_row(form.create) }}
    </div>
    {{ form_end(form) }}
{% endblock %}

