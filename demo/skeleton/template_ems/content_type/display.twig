{% block value_nl %}
    {% set locale = 'nl' %}{{ block('value') }}
{% endblock value_nl %}

{% block value_fr %}
    {% set locale = 'fr' %}{{ block('value') }}
{% endblock value_fr %}

{% block value %}
    {% if finalize %}
        {% set orderLocales = [locale]|merge(['nl', 'fr']|filter(v => v != locale)) %}
        {% set titles = orderLocales|map(l => _source.(l).title|default(null))|filter(v => v != null) %}

        {% if _type in ['page', 'news'] %}
            {{ titles|join(' / ')|default(null)|json_encode|raw }}
        {% endif %}
    {% endif %}
{% endblock value %}
