{%- trans_default_domain 'emsco-core' -%}

<nav class="navbar navbar-expand navbar-fixed">
    <a href="{{ path('homepage') }}" class="navbar-brand">
        <span class="align-middle">{{ ems_name|raw }}</span>
    </a>
    <div class="navbar-toolbar">
        <a href="#" class="sidebar-toggle js-sidebar-toggle" data-widget="pushmenu" role="button" aria-label="{{ 'key.push_menu'|trans }}">
            <i class="fa fa-bars"></i>
        </a>
        <div class="navbar-collapse collapse">
            <ul class="navbar-nav navbar-align">
                {% if app.user %}
                    {%- set channels = this.channels|default([]) -%}
                    {%- if channels|default([])|length > 0 -%}
                        <li class="nav-item dropdown">
                            <a class="nav-link" data-bs-toggle="dropdown" href="#">
                                <i class="fa fa-eye"></i>
                                <span class="visually-hidden">{{ 'key.channels'|trans({}, 'emsco-core') }}</span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end">
                                {%- set homepage = path('homepage') -%}
                                {%- for channel in channels -%}
                                    <a href="{{ channel.getEntryPath(homepage) }}" target="_blank" class="dropdown-item">
                                        <i class="fa fa-{{ channel.public|default ? 'unlock-alt' : 'lock' }} me-2"></i>
                                        {{ channel.label }}
                                    </a>
                                {%- endfor -%}
                            </div>
                        </li>
                    {%- endif -%}

                    {%- for dashboard in this.dashboards.children|default([]) -%}
                        <li class="nav-item">
                            <a href="{{ path(dashboard.route, dashboard.routeParameters) }}" class="nav-link{% if dashboard.color %} text-{{ dashboard.color }}{% endif %}">
                                <i class="{{ dashboard.icon }}"></i>
                            </a>
                        </li>
                    {%- endfor -%}

                    <li class="nav-item">
                        <a href="{{ path('notifications.inbox') }}" class="nav-link" title="{{ 'key.notifications'|trans({}, 'emsco-core') }}">
                            <i class="fa fa-envelope"></i>
                            {%- if this.countNotifications > 0 -%}
                                <span class="navbar-badge badge text-bg-warning">{{ this.countNotifications }}</span>
                            {%- endif -%}
                        </a>
                    </li>

                {% endif %}

                <li class="nav-item" id="system-messages">
                    <a class="nav-link" data-bs-toggle="offcanvas" href="#control-sidebar" role="button" aria-controls="control-sidebar">
                        <i id="ajax-activity" class="fa fa-refresh"></i>
                        <span class="visually-hidden">{{ 'action.toggle_sidebar'|trans }}</span>
                        <span id="activity-counter" class="badge navbar-badge"></span>
                    </a>
                </li>
                {% if is_granted('ROLE_SUPER_ADMIN') %}
                    {{ include('@EMSAdminUI/bootstrap5/elements/dev-panel.html.twig') }}
                {% endif %}

                {%- set statusTitle = 'cluster.status'|trans({color: this.status}, 'emsco-core') -%}
                {%- set statusColor = {green: 'success', yellow: 'warning', red: 'danger'}[this.status|default('red')]|default('secondary') -%}

                <li class="nav-item">
                    <a href="{{ path('elasticsearch.status') }}" id="status-overview" class="nav-link" title="{{ statusTitle }}">
                        <span class="position-relative d-inline-flex">
                            <i class="fa fa-heartbeat"></i>
                            <span class="navbar-status-dot bg-{{ statusColor }}"></span>
                        </span>
                        <span class="visually-hidden">{{ statusTitle }}</span>
                    </a>
                </li>

                {% if app.user %}
                    <li class="nav-item dropdown user-menu" data-testid="user-menu">
                        <a class="nav-link dropdown-toggle justify-content-center" href="#" data-bs-toggle="dropdown">
                            {{ include('@EMSAdminUI/bootstrap5/elements/user-image.html.twig', {
                                class: 'rounded-circle avatar-sm img-fluid',
                                width: 24,
                                height: 24,
                            }) }}
                            <span class="d-none d-sm-inline ms-2">{{ app.user.username }}</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end p-0">
                            <li class="user-header p-3 text-white text-center">
                                {{ include('@EMSAdminUI/bootstrap5/elements/user-image.html.twig', {
                                    class: 'rounded-circle border border-2 border-white border-opacity-50',
                                    width: 72,
                                    height: 72,
                                }) }}
                                <div class="fs-5 fw-semibold mt-2">{{ app.user.username }}</div>
                                <div class="small opacity-75">{{ 'message.member_since'|trans({date: app.user.created|date(date_time_format)}, 'emsco-core') }}</div>
                                <div class="user-roles d-flex flex-wrap justify-content-center gap-1 mt-3">
                                    {% for role in app.user.roles %}
                                        <span class="badge bg-white bg-opacity-25 fw-normal">{{ (role|replace({ROLE_: 'ROLE.'}) ~ '.label')|lower|trans([], 'emsco-core') }}</span>
                                    {% endfor %}
                                </div>
                            </li>
                            <li>
                                <a href="{{ path(routes.USER_PROFILE) }}" class="dropdown-item py-2"><i class="fa fa-user fa-fw"></i> {{ 'title.profile'|trans({}, 'emsco-core') }}</a>
                            </li>
                            <li><hr class="dropdown-divider my-0"></li>
                            {% if is_granted('IS_IMPERSONATOR') %}
                                <li>
                                    <a href="{{ path('emsco_user_index', {_switch_user: '_exit'}) }}" class="dropdown-item py-2" data-testid="logout"><i class="fa fa-sign-out fa-fw" aria-hidden="true"></i> {{ 'action.exit'|trans({}, 'emsco-core') }}</a>
                                </li>
                            {% else %}
                                <li>
                                    <a href="{{ path(routes.USER_LOGOUT) }}" class="dropdown-item py-2" data-testid="logout"><i class="fa fa-sign-out fa-fw" aria-hidden="true"></i> {{ 'action.sign_out'|trans({}, 'emsco-core') }}</a>
                                </li>
                            {% endif %}
                        </ul>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>
