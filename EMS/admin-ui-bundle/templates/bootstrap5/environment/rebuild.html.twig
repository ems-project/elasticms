{% extends '@EMSAdminUI/bootstrap5/base/admin.html.twig' %}{% trans_default_domain 'emsco-core' %}

{% block title %}{{ 'title.rebuild_environment'|trans({'name': environment.name}) }}{% endblock %}
{% block pagetitle %}{{ 'title.rebuild_environment'|trans({'name': environment.name}) }}{% endblock %}
{% block breadcrumb %}
    <ol class="breadcrumb float-sm-end">
        <li class="breadcrumb-item"><i class="fa fa-database"></i> {{ 'field.environments'|trans }}</li>
        <li class="breadcrumb-item"><a href={{ path('emsco_admin_environment_index') }}>{{ 'title.list_environments'|trans }}</a></li>
           <li class="breadcrumb-item active">{{ 'title.rebuild_index_short'|trans }}</li>
       </ol>
{% endblock %}

{% block body %}
<div class="row">
    <div class="col-md-6">
        <div class="card card-warning card-outline">
            <div class="card-header">
                <h3 class="card-title"><i class="fa fa-warning"></i> {{ 'key.notice'|trans }}</h3>
            </div>
            <!-- /.box-header -->
            <div class="card-body">
                <p>
                    {{ 'message.environment_rebuild_notice'|trans }}
                </p>
            </div>
            <!-- /.box-body -->
        </div>
    </div>
    <div class="col-md-6">
        <div class="card card-{{ theme_color }} card-outline">
            <div class="card-header">
                <h3 class="card-title">{{ 'title.select_your_options'|trans }}</h3>
            </div>
            <!-- /.box-header -->
            <!-- form start -->
            {{ form_start(form) }}
                <div class="card-body">
                    {{ form_row(form.option) }}
                </div>
                <!-- /.box-body -->
                <div class="card-footer">
                    <div class="btn-group text-end">
                        {{ form_widget(form.rebuild) }}
                    </div>
                </div>
                <!-- /.box-footer -->

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
