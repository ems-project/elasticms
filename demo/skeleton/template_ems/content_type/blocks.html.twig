{% block paragraph %}
    {%- if item.object.body is defined -%}
        {%- set panelBody = emsco_diff_html(item.object.body, false, item.id, null) -%}
        {%- set bodyField = def.fieldType.getChildByName('paragraph').getChildByName('body') -%}
        {%- set styleSetPreview = bodyField.getDisplayOption('styles_set_preview') -%}
        {%- if styleSetPreview -%}
            {%- set iframeUrl = path('emsco_wysiwyg_styleset_iframe', {
                'name': bodyField.getDisplayOption('styles_set', 'default'),
                'language': 'en',
                'emsLink': null,
                'field': 'body',
                'fieldPath': def.id
            }) -%}
            <iframe src="{{ iframeUrl }}" class="styleset-preview panel-body" data-iframe-body="{{ panelBody|e('html_attr') }}"></iframe>
        {%- else -%}
            {{- panelBody|raw -}}
        {%- endif -%}
    {%- endif -%}
{% endblock paragraph %}