# editorconfig.org
root = true

; Unix-style newlines
[*]
charset = utf-8
end_of_line = LF
indent_size = 2
trim_trailing_whitespace = true
indent_style = space

[*.md]
trim_trailing_whitespace = false
max_line_length = 100

[*.{yml,yaml,php,html,twig,json,xml,js,ts,mts,md}]
indent_size = 4

[*.php]
trim_trailing_whitespace = false

[COMMIT_EDITMSG]
max_line_length = 0
