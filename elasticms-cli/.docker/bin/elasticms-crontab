#!/usr/bin/env bash
set -eo pipefail

export DEBUG=${DEBUG:-false}
[[ "${DEBUG}" == "true" ]] && set -x

# A command given after `crontab` replaces the default one, set by 10-init.sh.
if [[ $# -gt 0 ]]; then
    export ELASTICMS_CLI_CROND_COMMAND="$*"
fi

# The early hooks (entrypoint.d) have already run: base-php's cli entrypoint
# sources them before it execs this script. Only the helper functions are
# loaded here -- they do not cross an exec.
source /usr/local/bin/container-entrypoint.d/entrypoint.d/00-functions.sh

for FILE in $(find /opt/bin/container-entrypoint.d/elasticms.d -iname \*.sh | sort)
do
    source ${FILE}
done

log "INFO" "+---- ElasticMS CLI Container ( Crontab ) configured succesfully -----"

# supercronic is the container's only process, under dumb-init: base-php's cli
# variant renders no supervisord configuration, and supervisord added nothing
# but a restart loop around a scheduler that does not crash on a failing job.
# shellcheck disable=SC2086 # the flags are a word list
exec /usr/bin/supercronic ${ELASTICMS_CLI_SUPERCRONIC_COMMAND_FLAGS} /opt/etc/crontabs/elasticms
