			count: 1
			path: EMS/client-helper-bundle/src/Security/CoreApi/CoreApiAuthenticator.php

		-
			message: '#^Property EMS\\CommonBundle\\Common\\CoreApi\\Endpoint\\Admin\\Message\\Job\:\:\$command \(string\|null\) is never assigned null so it can be removed from the property type\.$#'
			identifier: property.unusedType
			count: 1
