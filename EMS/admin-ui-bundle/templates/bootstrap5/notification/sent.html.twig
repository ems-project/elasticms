{% trans_default_domain 'emsco-core' %}{% if countSent %}
    <div class="box box-primary ">
        <div class="box-header with-border">
            <h3 class="box-title">
                <i class="fa fa-envelope-o"></i> {{ 'key.sent'|trans }}
            </h3>

            {{ include('@EMSAdminUI/bootstrap5/elements/pagination.html.twig', {
                lastPage: lastPage,
                currentPage: page,
                currentFilters: app.request.query,
                paginationPath: paginationPath,
                showAlwaysFirstAndLast: false,
            }) }}
        </div>
        <!-- /.box-header -->
        <div class="box-body ">

        {% if notifications|length <= 0 %}
        <p>{{ 'message.notification_no_results'|trans }}: <a href="{{ path('notifications.sent') }}">{{ 'action.reset_filters'|trans }}</a></p>
        {% else %}
        <div class="table-responsive">
                        <table class="table table-condensed table-striped">
                            <tbody>
                                <tr>
                                    <th class="" style="">
                                          {{ 'key.notification'|trans }}
                                    </th>
                                    <th>{{ 'field.created_by'|trans }}</th>
                                    <th>{{ 'field.date'|trans }}</th>
                                    <th>{{ 'field.environment'|trans }}</th>
                                    <th>{{ 'key.warnings'|trans }}</th>
                                    <th>{{ 'field.revision'|trans }}</th>
                                    <th>{{ 'key.actions'|trans }}</th>
                                </tr>
                            </tbody>
                            {% for notification in notifications %}
                                <tr>
                                    <td class="" nowrap="nowrap">
                                        <i class="{{ notification.template.icon }}"></i> {{ notification.template.label }}

                                    </td>
                                    <td>{{ notification.username|emsco_display_name }}</td>
                                    <td>{{ notification.created|date|date(date_time_format) }}</td>
                                    <td>
                                        <span class="badge bg-{{ notification.environment.color|raw }}">{{ notification.environment.name }}</span>
                                    </td>
                                    <td>
                                    {% set found = false %}
                                    {% for env in notification.revision.environments %}
                                        {% if env == notification.environment %}
                                            {% set found = true %}
                                        {% endif %}
                                    {% endfor %}
                                    {% if not found and notification.counter > 1 %}
                                        <i class="fa fa-warning  text-{{ notification.revision.contentType.color }}" title="{{ 'message.revision_not_published_and_duplicate'|trans({'environment': notification.name}) }}"></i> {{ 'message.revision_not_published_and_duplicate'|trans({'environment': notification.environment.name}) }}
                                    {% elseif not found %}
                                        <i class="fa fa-warning  text-{{ notification.revision.contentType.color }}" title="{{ 'message.revision_not_published'|trans({'environment': notification.environment.name}) }}"></i> {{ 'message.revision_not_published'|trans({'environment': notification.environment.name}) }}
                                    {% elseif notification.counter > 1 %}
                                        <i class="fa fa-warning  text-{{ notification.revision.contentType.color }}" title="{{ 'message.notification_duplicate'|trans }}"></i> {{ 'message.notification_duplicate'|trans }}
                                    {% else %}
                                        <i class="fa fa-thumbs-up  text-{{ notification.revision.contentType.color }}"></i>
                                    {% endif %}
                                    &nbsp;
                                    </td>
                                    <td>
                                        {{ (notification.revision.contentType.name ~ ':' ~ notification.revision.ouuid)|emsco_data_link(notification.revision.id)|raw }}

                                    <td>
                                        <div class="btn-group">
                                            {% if is_granted(notification.template.role) %}
                                                {{ include('@EMSAdminUI/bootstrap5/elements/post-button.html.twig', {
                                                    url: path('notification.cancel', {notification: notification.id}),
                                                    label: 'action.cancel'|trans({}, 'emsco-core'),
                                                    icon: 'ban',
                                                    message: 'action.confirmation'|trans,
                                                }) }}
                                            {% endif %}

                                            {{ include('@EMSAdminUI/bootstrap5/elements/object-views-button.html.twig', {
                                                object: notification.revision.buildObject,
                                                contentType: notification.revision.contentType,
                                                environment: notification.environment,
                                                ouuid: notification.revision.ouuid,
                                                currentTemplate: notification.template,
                                            }) }}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </table>
                        </div>
            {% endif %}
        </div>
    </div>

{% else %}
          <div class="box box-default">
            <div class="box-header with-border">
              <i class="fa fa-check"></i>

              <h3 class="box-title">{{ 'key.empty'|trans }}</h3>
            </div>
            <!-- /.box-header -->
            <div class="box-body">

              <div class="callout callout-success">
                <h4>{{ 'title.notifications_none_pending'|trans }}</h4>
              </div>
            </div>
            <!-- /.box-body -->
          </div>
          <!-- /.box -->
{% endif %}
