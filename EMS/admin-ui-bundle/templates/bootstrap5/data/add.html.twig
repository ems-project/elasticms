{% extends '@EMSAdminUI/bootstrap5/base/admin.html.twig' %}{% trans_default_domain 'emsco-core' %}

{% block title %}{{ 'data.add.title'|trans({'content_type': contentType.singularName}) }}{% endblock %}
{% block pagetitle %}{{ 'data.add.title'|trans({'content_type': contentType.singularName}) }}{% endblock %}
{% block subtitle %}<small>{{ 'title.content_type_create_ouuid'|trans({ 'content_type': contentType.singularName }) }}</small>{% endblock %}

{% block body %}

<div class="row">
    <div class="col-md-6">
        <div class="card card-warning card-outline">
            <div class="card-header">
                <h3 class="card-title"><i class="fa fa-warning"></i> {{ 'notice_card.title'|trans }}</h3>
            </div>
            <!-- /.box-header -->
            <div class="card-body">
                <p>{{ 'message.content_type_info_ouuid'|trans({ 'content_type': contentType.singularName  })|raw|nl2br }}</p>
            </div>
            <!-- /.box-body -->
        </div>
    </div>
    <div class="col-md-6">
        <!-- general form elements -->
        <div class="card card-{{ theme_color }} card-outline card-outline-tabs">
            <div class="card-header">
                <h3 class="card-title">{{ 'data.add.new_title'|trans({'content_type': contentType.singularName}) }}</h3>
            </div>
            <!-- /.box-header -->
            <!-- form start -->
            {{ form_start(form) }}

                <div class="card-body">
                    {{ form_row(form.ouuid) }}

                </div>
                <!-- /.box-body -->
                <div class="card-footer">
                    {{ form_widget(form.save) }}
                </div>
            {{ form_end(form) }}

        </div>
        <!-- /.box -->
    </div>
</div>
{% endblock %}
