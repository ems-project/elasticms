{% extends '@EMSCH/template/fragments/structure.html.twig' %}
{% trans_default_domain trans_default_domain %}

{% block dropdownSubmenu %}
    {% if link.object.(locale).title is defined %}
        <li class="dropdown-submenu">
            <a class="dropdown-item dropdown-toggle" href="{{ urls.(link.id) is defined ? urls.(link.id) : '#' }}">{{ link.object.(locale).title }}</a>
            <ul class="dropdown-menu">
                {% for link in link.children|filter(link => urls.(link.id) is defined) %}
                    {% if link.children|length > 0 and link.object.dropdown|default(false) %}
                        {{ block('dropdownSubmenu') }}
                    {% else %}
                        {{ block('dropdownItem') }}
                    {% endif %}
                {% endfor %}
            </ul>
        </li>
    {% endif %}
{% endblock %}

{% block dropdownItem %}
    {% if link.object.(locale).title is defined %}
        <li><a class="dropdown-item" href="{{ urls.(link.id) }}">{{ link.object.(locale).title }}</a></li>
    {% endif %}
{% endblock %}

{% block dropdown %}
    {% if section.object.(locale).title is defined %}
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="{{ urls.(section.id) is defined ? urls.(section.id) : '#' }}" id="{{ section.id }}" role="button"
               data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                {{ section.object.(locale).title }}
            </a>
            <ul class="dropdown-menu" aria-labelledby="{{ section.id }}">
                {% for link in section.children %}
                    {% if link.children|length > 0 and link.object.dropdown|default(false) %}
                        {{ block('dropdownSubmenu') }}
                    {% elseif urls.(link.id) is defined %}
                        {{ block('dropdownItem') }}
                    {% endif %}
                {% endfor %}
            </ul>
        </li>
    {% endif %}
{% endblock %}

{% block item %}
    {% if urls.(section.id) is defined and section.object.(locale).title is defined %}
        <li class="nav-item">
            <a class="nav-link" href="{{ urls.(section.id) }}">{{ section.object.(locale).title }}</a>
        </li>
    {% endif %}
{% endblock %}

{% block request %}
    {% for section in structure.children|filter(p => pages.(p.id) is defined)  %}
        {% if section.children|length > 0 and section.object.dropdown|default(false) %}
            {{ block('dropdown') }}
        {% else %}
            {{ block('item') }}
        {% endif %}
    {% endfor %}
{% endblock %}
