{% trans_default_domain 'emsco-core' %}

{% set status = this.status %}

<nav id="sidebar" class="sidebar">
    <div class="sidebar-content">
        {%- if app.user -%}
            <form class="px-3 pt-3 pb-3 sidebar-search" action="{{ path('ems_quick_search') }}" method="get">
                <div class="input-group input-group-sidebar">
                    <input class="form-control" type="search" name="q" placeholder="{{ 'key.search'|trans }}" aria-label="{{ 'key.search'|trans }}">
                    <button class="btn" type="submit" aria-label="{{ 'key.show_search_form'|trans }}">
                        <i class="fas fa-search align-middle"></i>
                    </button>
                </div>
            </form>
        {%- endif -%}

        <ul class="sidebar-nav">
            {% for item in this.menus|filter(p => p.hasChildren) %}
                <li class="sidebar-header">{{ item.title|trans }}</li>
                {% for menu in item.children %}
                    {{ _self.item(menu) }}
                {% endfor %}
            {% endfor %}
        </ul>
    </div>
</nav>

{% macro item(menu) %}
    <li class="sidebar-item">
        <a href="{{ menu.hasChildren ? '#' : path(menu.route, menu.routeParameters) }}" class="sidebar-link{% if menu.color %} text-{{ menu.color }}{% endif %}{% if menu.hasChildren %} collapsed{% endif %}" {% if menu.hasChildren %}data-bs-target="#nav-{{ menu.label|ems_slug }}" data-bs-toggle="collapse"{% endif %}>
            <i class="align-middle {{ menu.icon }}"></i>
            <span class="align-middle">
                {{ menu.label is ems_translatable_message ? menu.label|trans : menu.label }}
                {% if menu.hasBadge %}
                    <span class="sidebar-badge badge {{ menu.badgeColor ? 'bg-' ~ menu.badgeColor : 'bg-primary' }}">{{ menu.badge }}</span>
                {% endif %}
            </span>
        </a>
        {% if menu.hasChildren %}
            <ul id="nav-{{ menu.label|ems_slug }}" class="sidebar-dropdown list-unstyled collapse">
                {% for child in menu.children %}
                    {{ _self.item(child) }}
                {% endfor %}
            </ul>
        {% endif %}
    </li>
{% endmacro %}