{% extends '@EMSAdminUI/bootstrap5/template/card.html.twig' %}

{% block form %}
    <div class="row">
        {{ form_row(form.label) }}
        <div class="clearfix"></div>
        {{ form_row(form.name) }}
        <div class="clearfix"></div>
        {{ form_row(form.alias) }}
        <div class="clearfix"></div>
        {{ form_row(form.public) }}
        {% for item in form.options %}
            <div class="clearfix"></div>
            {{ form_row(item) }}
        {% endfor %}
    </div>
{% endblock form %}
