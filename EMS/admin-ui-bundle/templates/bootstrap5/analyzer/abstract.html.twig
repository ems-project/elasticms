{% extends '@EMSAdminUI/bootstrap5/template/card.html.twig' %}
{% trans_default_domain 'ems-adminui-twigs' %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-3">
                {{ block('notice') }}
            </div>
            <div class="col-md-9">
                {{ parent() }}
            </div>
        </div>
    </div>
{% endblock body %}

{% block notice %}
    {% with {
        content: notice|trans,
        cardTitle: 'notice_card.title'|trans,
        cardTitleIcon: 'fa fa-warning',
        form: null,
        warning: null,
    } %}
        {{ block('body', '@EMSAdminUI/bootstrap5/template/card.html.twig') }}
    {% endwith %}
{% endblock notice %}
