{% extends '@EMSAdminUI/bootstrap5/base/admin.html.twig' %}
{% trans_default_domain 'emsco-core' %}

{% block title %}
    {%- if type == 'publish' -%}
        {{- 'title.release_revision_list_publish'|trans -}}
    {%- elseif type == 'unpublish' -%}
        {{- 'title.release_revision_list_unpublish'|trans -}}
    {%- endif -%}
{% endblock %}

{% block pagetitle %}{{ block('title') }}{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb float-sm-end">
        <li class="breadcrumb-item"><a href="{{ path('emsco_release_index') }}"><i class="fa fa-cube}"></i> {{ 'key.releases'|trans }}</a></li>
        <li class="breadcrumb-item">{{ 'key.add_documents'|trans }}</li>
       </ol>
{% endblock %}

{% block body %}
    {% form_theme form '@EMSAdminUI/bootstrap5/form/forms.html.twig' %}
    {{ form(form) }}
{% endblock %}
