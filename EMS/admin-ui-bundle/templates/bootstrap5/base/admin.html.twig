{% extends '@EMSAdminUI/bootstrap5/base/html5.html.twig' %}
{%- trans_default_domain 'emsco-core' -%}

{%- set wysiwygInfo = emsco_wysiwyg_info() -%}
{%- set html_attr = {
    'data-theme': theme_color,
    'data-bs-theme': 'light',
    'data-sidebar-collapsed': app.user?.sidebarCollapse|default(false),
} -%}

{%- set body_attr = {
    'data-hash-algo': ems_hash_algo,
    'data-status-url': path('elasticsearch.status', {_format: 'json'}),
    'data-search-api': path('elasticsearch.api.search'),
    'data-init-upload': path('emsco_file_data_init_upload'),
    'data-revision-url': path('emsco_view_revisions', {
        type: '__type__',
        ouuid: '__ouuid__',
    }),
    'data-file-view': path('ems.file.view', {sha1: '__file_identifier__', name: '__file_name__'}),
    'data-file-extract': path('ems_file_extract', {sha1: '__file_identifier__', name: '__file_name__'}),
    'data-file-extract-forced': path('ems_file_extract_forced', {sha1: '__file_identifier__', name: '__file_name__'}),
    'data-wysiwyg-type-filters': wysiwygInfo.linkTypes|json_encode,
    'data-wysiwyg-info': wysiwygInfo|json_encode,
    'data-asset-path': asset(''),
} -%}

{% block breadcrumb %}
    {% if breadcrumb is defined %}
        <ol class="breadcrumb float-sm-end">
            {# @var item \EMS\CoreBundle\Core\UI\Page\NavigationItem #}
            {% for item in breadcrumb.items %}
                {%- set label -%}
                    {% if item.icon %}<i class="{{ item.icon }}"></i>&nbsp;{% endif %}
                    {{ item.label ? item.label|trans : item.text|default('...') }}
                {%- endset -%}
                <li class="{{ html_classes('breadcrumb-item', {active: loop.last}) }}">
                    {% if item.route and loop.last == false %}
                        <a href="{{ path(item.route, item.routeParams) }}">{{ label }}</a>
                    {% else %}
                        {{ label }}
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    {% endif %}
{% endblock breadcrumb %}

{% block wrapper %}
    <div class="wrapper">
        <twig:ems_layout_sidebar />
        <div class="main">
            <twig:ems_layout_topbar />
            {{ include('@EMSAdminUI/bootstrap5/elements/toasts.html.twig') }}
            <main class="content">
                <div class="container-fluid p-0">
                    <div class="row mb-3">
                        <div class="col-sm-6">
                            <h1 class="h3 mb-0">{% block pagetitle %}<strong>{{ block('title') }}</strong>{% endblock %}</h1>
                            {% block subtitle %}{% if subTitle is defined %} <small>{{ subTitle|trans }}</small>{% endif %}{% endblock %}
                        </div>
                        <div class="col-sm-6">
                            {{ block('breadcrumb') }}
                        </div>
                    </div>
                    {% block body %}{% endblock body %}
                </div>
            </main>
            {{ block('footer') }}
        </div>
        <twig:ems_layout_control_sidebar />
    </div>
{% endblock wrapper %}

{%- block footer -%}
    <footer class="footer no-print">
        {% if app.user %}
            <a href="https://elasticms.fgov.be/" target="_blank">elastic<strong>MS</strong></a>
            <div class="float-end d-none d-sm-inline-block">
                {{ 'core.version'|trans({core: ems_version('core'), symfony: ems_version('symfony')}) }}
            </div>
        {% endif %}
    </footer>
{%- endblock footer -%}
