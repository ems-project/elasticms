{#
    Temporary developer-only tooling (ROLE_SUPER_ADMIN only) for quickly
    previewing sidebar/theme states via localStorage, without touching
    server config. Not translated on purpose - safe to remove later.
#}
<li class="nav-item dropdown" data-testid="dev-panel">
    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" data-bs-auto-close="outside" title="Dev panel">
        <i class="fa fa-flask"></i>
    </a>
    <ul class="dropdown-menu dropdown-menu-end p-3" style="min-width: 220px;">
        <li class="dropdown-header px-0">Dev panel</li>

        <li class="mb-2">
            <label class="form-label mb-1" for="devThemeMode">Mode</label>
            <select id="devThemeMode" class="form-select form-select-sm">
                <option value="light">Light</option>
                <option value="dark">Dark</option>
            </select>
        </li>

        <li class="mb-2">
            <label class="form-label mb-1" for="devThemeColor">Theme color (sidebar/topbar)</label>
            <select id="devThemeColor" class="form-select form-select-sm">
                {# AdminLTE2 skin colors only - matches $theme-colors keys in variables/_app.scss #}
                {% for color in ['light-blue', 'purple', 'green', 'red', 'yellow'] %}
                    <option value="{{ color }}">{{ color }}</option>
                {% endfor %}
            </select>
        </li>

        <li class="form-check form-switch mb-1">
            <input class="form-check-input" type="checkbox" role="switch" id="devSidebarCollapsed">
            <label class="form-check-label" for="devSidebarCollapsed">Sidebar collapsed</label>
        </li>
        <li class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="devSidebarMini">
            <label class="form-check-label" for="devSidebarMini">Sidebar mini</label>
        </li>
    </ul>
</li>
