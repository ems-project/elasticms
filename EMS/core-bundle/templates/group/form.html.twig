{% extends '@EMSCore/group/abstract.html.twig' %}
{% trans_default_domain 'emsco-twigs' %}


{% block breadcrumb_items %}<li>{{ block('title') }}</li>{% endblock breadcrumb_items %}


{% block body %}
    <div class="row">
        <div class="col-md-6">
            {{ form(form) }}
        </div>

        <div class="col-md-6">
            <div class="row">
                <div class="col-md-12">
                    <div class="box">
                        <div class="box-header with-border">
                            <table class="table table-bordered table-striped">
                                <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                </tr>
                                </thead>
                                <tbody>
                                {%- for mapKey, mapValue in users -%}
                                    <tr>
                                        <td>{{ mapValue.name|default('missing') }}</td>
                                        <td>{{ mapValue.email|default('missing') }}</td>
                                    </tr>
                                {%- endfor -%}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <form action="/admin/group">
        <button type="submit" class="btn btn-primary">cancel</button>
    </form>
{% endblock %}
