{%- block actions -%}
    <button class="btn" title="Discard" data-editor-action="discard">
        <i class="fa-solid fa-trash-can"></i>Discard
    </button>
{%- endblock actions -%}

{%- block sidebarDraft -%}
    {{ dump(element) }}
{%- endblock sidebarDraft -%}

{%- block elements -%}
    {%- if infos|length > 0 -%}
        <ul class="list-documents">
            {%- for info in infos -%}
                <li class="document-card">
                    <div class="document-header">
                        <span class="document-name">{{ info.label }}</span>
                        <span class="badge warning"></span>
                    </div>
                    <dl class="meta">
                        <dt>Content type</dt>
                        <dd>{{ info.contentType.singularName }}</dd>
                        <dt>Draft</dt>
                        <dd>{{ info.draft ? 'Yes' : 'No' }}</dd>
                        {% for env,status in info.status %}
                            <dt>{{ env|capitalize }}</dt>
                            <dd><span class="{{ html_classes('badge', {
                                'success': status === 'published',
                                'warning': status === 'outdated',
                                'danger': status === 'not_published'
                            }) }}">{{ status }}</span></dd>
                        {% endfor %}
                    </dl>
                    <ul>
                        {%- for element in info.elements -%}
                            <li>{{ element.path }}</li>
                        {%- endfor -%}
                    </ul>
                </li>
            {%- endfor -%}
        </ul>
    {%- endif -%}
{%- endblock elements -%}


