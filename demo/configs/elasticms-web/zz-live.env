###> Nginx ###
NGINX_SERVER_NAME='~^(local\.live-[^.]+-web(-nocache)?\.localhost)$'
NGINX_BUNDLES_LOCATION_CACHE_CONTROL='immutable, max-age=63072000, public'
NGINX_X_FRAME_OPTIONS=SAMEORIGIN
NGINX_REFERRER_POLICY='no-referrer-when-downgrade'
NGINX_CONTENT_SECURITY_POLICY="script-src 'self'"
#NGINX_ACCESS_CONTROL_ALLOW_ORIGIN='https://elasticms.fgov.be'
NGINX_PERMISSIONS_POLICY='accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=(), interest-cohort=()'
NGINX_STRICT_TRANSPORT_SECURITY='max-age=31536000; includeSubDomains'
NGINX_ENVIRONMENTS='[{"alias":"/live/demo","env":"live"},{"alias":"/demo","env":"live"}]'
NGINX_CUSTOM_ASSETS_RC='/(bundles|skeleton)'
###< Nginx ###

###> Symfony ###
APP_ENV=${APP_ENV}
APP_SECRET=${APP_SECRET}
APP_LOG_DIR='${APP_LOG_DIR}/zz-live'
APP_CACHE_DIR='${APP_CACHE_DIR}/zz-live'
DEFAULT_LOCAL=nl
TRUSTED_PROXIES='127.0.0.1,REMOTE_ADDR'
TRUSTED_HOSTS='${TRUSTED_HOSTS}'
HTTP_CUSTOM_FORWARDED_HOST='${HTTP_CUSTOM_FORWARDED_HOST}'
HTTP_CUSTOM_FORWARDED_FOR='${HTTP_CUSTOM_FORWARDED_FOR}'
HTTP_CUSTOM_FORWARDED_PROTO='${HTTP_CUSTOM_FORWARDED_PROTO}'
HTTP_CUSTOM_FORWARDED_PORT='${HTTP_CUSTOM_FORWARDED_PORT}'
###< Symfony ###

###> Redis ###
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=${REDIS_PORT}
###< Redis ###

###> Common ###
EMS_BACKEND_URL='${EMS_BACKEND_URL}'
EMS_STORAGES='[{"type":"s3","credentials":{"version":"2006-03-01","credentials":{"key":"${S3_ACCESS_KEY_ID}","secret":"${S3_SECRET_ACCESS_KEY}"},"region":"${S3_DEFAULT_REGION}","endpoint":"${S3_ENDPOINT_URL}","use_path_style_endpoint":true},"bucket":"${S3_BUCKET_NAME}"}]'
EMS_CACHE='redis'
EMS_METRIC_ENABLED='true'
EMS_METRIC_PORT='9099'
EMS_CACHE_PREFIX='${INSTANCE_ID}live'
EMS_EXCLUDED_CONTENT_TYPES='["route","template","template_ems","label"]'
###> Common ###

###> EMSCH ###
EMSCH_LOCALES='["nl","fr"]'
EMSCH_BIND_LOCALE='false'
EMSCH_BACKEND_URL='${EMS_BACKEND_URL}'
EMSCH_TEMPLATE_ERROR='@EMSCH/template/error/error{code}.{_format}.twig'
EMSCH_ENV='live'
EMSCH_ENVS='{"live":{"regex":"/.*/","alias":"${INSTANCE_ID}ma_live"}}'
EMSCH_TEMPLATE_EMS_LINK='@EMSCH/template/ems/{type}.ems_link.twig'
###< EMSCH ###

###> EMS Form ###
EMSF_LOAD_FROMJSON=true
EMSF_AUTHKEY='${EMSF_AUTHKEY}'
###< EMS Form ###
#EOF
