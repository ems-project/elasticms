			count: 1
			path: EMS/client-helper-bundle/src/Helper/Search/QueryBuilder.php

		-
			message: '#^Dead catch \- EMS\\CommonBundle\\Contracts\\CoreApi\\Exception\\NotAuthenticatedExceptionInterface is never thrown in the try block\.$#'
