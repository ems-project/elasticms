{% use "@EMSClientHelper/inlineEdit/render.html.twig" %}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Inline Editor</title>
    <link rel="stylesheet" href="{{ asset('src/inline-editor/editor.ts.css', 'emsclienthelper') }}">
    {%- if vite.isDevServerRunning -%}
        <script type="module" src="{{- vite.devServerClient -}}"></script>
    {%- endif -%}
    <script src="{{ asset('src/inline-editor/editor.ts', 'emsclienthelper') }}" type="module"></script>
</head>
<body data-render-url="{{ path(constant('EMS\\ClientHelperBundle\\Routes::INLINE_EDIT_RENDER')) }}">
<div class="editor" id="editor">
    <header class="editor-topbar"></header>
    <div class="editor-body" id="editorBody">
        <main class="editor-preview">
            <iframe id="preview-iframe" src="{{ iframeUrl }}"></iframe>
        </main>
        <aside id="sidebar">
            <div class="editor-resize-handle" id="resizeHandle"></div>
            <div class="editor-sidebar">

            </div>
        </aside>
    </div>
</div>
</body>
</html>
