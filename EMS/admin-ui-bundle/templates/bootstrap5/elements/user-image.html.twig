{% if app.user %}
    <img src="{{ asset('images/anonymous.gif', 'emscore') }}" data-original="https://www.gravatar.com/avatar/{{ app.user.email|lower|ems_md5 }}?s=256" class="{{ class }} lazy" alt="{{ app.user.displayName }}" width="{{ width|default(128) }}" height="{{ height|default(128) }}">
{% else %}
    <img src="{{ asset('images/anonymous.gif', 'emscore') }}" class="{{ class }}" alt="{{ 'key.anonymous_user'|trans({}, 'emsco-core') }}" width="{{ width|default(128) }}" height="{{ height|default(128) }}">
{% endif %}
