{
    "name": "elasticms/common-bundle",
    "description": "All code shared between the EMS client helper and the EMS core",
    "type": "symfony-bundle",
    "keywords": [
        "elasticms"
    ],
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "EMS Community",
            "homepage": "https://github.com/ems-project/elasticms/contributors"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-exif": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-zip": "*",
        "aws/aws-sdk-php": "^3.294",
        "cebe/markdown": "^1.2",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/orm": "^3.3",
        "dompdf/dompdf": "^v3.1",
        "elasticms/helpers": "7.2.*",
        "guzzlehttp/guzzle": "^7.8",
        "maennchen/zipstream-php": "^3.0",
        "phpoffice/phpspreadsheet": "^5.4",
        "promphp/prometheus_client_php": "^2.9",
        "psr/simple-cache": "^3.0",
        "ramsey/uuid-doctrine": "^2.1",
        "ruflin/elastica": "^8.0",
        "symfony/console": "7.4.*",
        "symfony/dom-crawler": "7.4.*",
        "symfony/event-dispatcher": "7.4.*",
        "symfony/expression-language": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/mime": "7.4.*",
        "symfony/monolog-bundle": "^3.8",
        "symfony/options-resolver": "7.4.*",
        "symfony/process": "7.4.*",
        "symfony/property-access": "7.4.*",
        "symfony/routing": "7.4.*",
        "symfony/security-core": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/stopwatch": "7.4.*",
        "symfony/translation": "7.4.*",
        "twig/cache-extra": "^3.8",
        "twig/cssinliner-extra": "^3.8",
        "twig/extra-bundle": "^3.8",
        "twig/html-extra": "^3.8",
        "twig/inky-extra": "^3.8",
        "twig/intl-extra": "^3.8",
        "twig/markdown-extra": "^3.8",
        "twig/string-extra": "^3.8",
        "twig/twig": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "EMS\\CommonBundle\\": "src/"
        }
    },
    "config": {
        "lock": false,
        "sort-packages": true
    }
}
