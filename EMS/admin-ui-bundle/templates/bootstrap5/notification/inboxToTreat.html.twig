{% trans_default_domain 'ems-adminui-twigs' %}{{ form_start(treatform) }}

    {% if notifications|length <= 0 %}
        <p>{{ 'notification.no_result_for_filters'|trans }}: <a href="{{ path('notifications.inbox') }}">{{ 'notification.reset_filters'|trans }}</a></p>
    {% else %}

        <div class="table-responsive">
        <table class="table table-condensed table-striped">
            <tbody>
                <tr>
                    <th class="" style="">
                        <input type="checkbox" data-grouped-checkbox-target=".item-to-treat">
                          &nbsp;{{ 'notification.label'|trans }}
                    </th>
                    <th>{{ 'notification.created_by'|trans }}</th>
                    <th>{{ 'notification.date'|trans }}</th>
                    <th>{{ 'notification.environment'|trans }}</th>
                    <th>{{ 'notification.warnings'|trans }}</th>
                    <th>{{ 'notification.revision'|trans }}</th>
                    <th>{{ 'notification.actions'|trans }}</th>
                </tr>
            </tbody>
            {% for notification in notifications %}
                <tr>
                    <td class="" nowrap="nowrap">
                        <label id="treat_notifications_notifications_{{ notification.id }}_label">
                            &nbsp;&nbsp;&nbsp;<input class="item-to-treat" type="checkbox" id="treat_notifications_notifications_{{ notification.id }}" name="treat_notifications[notifications][{{ notification.id }}]" label="treat_notifications_notifications_{{ notification.id }}_label" value="{{ notification.id }}">
                            &nbsp;&nbsp;&nbsp;<i class="{{ notification.template.icon }}"></i> {{ notification.template.label }}
                        </label>
                    </td>
                    <td>{{ notification.username|emsco_display_name }}</td>
                    <td>{{ notification.created|date|date(date_time_format) }}</td>
                    <td>
                        <span class="badge bg-{{ notification.environment.color|raw }}">{{ notification.environment.name }}</span>
                    </td>
                    <td>
                    {% set found = false %}
                    {% for env in notification.revision.environments %}
                        {% if env == notification.environment %}
                            {% set found = true %}
                        {% endif %}
                    {% endfor %}
                    {% if not found and notification.counter > 1 %}
                        <i class="fa fa-warning  text-{{ notification.revision.contentType.color }}" title="{{ 'notification.warning.revision_not_published_and_duplicate'|trans({'%environment%': notification.name}) }}"></i> {{ 'notification.warning.revision_not_published_and_duplicate'|trans({'%environment%': notification.environment.name}) }}
                    {% elseif not found %}
                        <i class="fa fa-warning  text-{{ notification.revision.contentType.color }}" title="{{ 'notification.warning.revision_not_published'|trans({'%environment%': notification.environment.name}) }}"></i> {{ 'notification.warning.revision_not_published'|trans({'%environment%': notification.environment.name}) }}
                    {% elseif notification.counter > 1 %}
                        <i class="fa fa-warning  text-{{ notification.revision.contentType.color }}" title="{{ 'notification.warning.duplicate'|trans }}"></i> {{ 'notification.warning.duplicate'|trans }}
                    {% else %}
                        <i class="fa fa-thumbs-up  text-{{ notification.revision.contentType.color }}"></i>
                    {% endif %}
                    &nbsp;
                    </td>
                    <td>
                        {{ (notification.revision.contentType.name ~ ':' ~ notification.revision.ouuid)|emsco_data_link(notification.revision.id)|raw }}

                    <td>
                        <div class="btn-group">
                            <button onclick="javascript: $('.item-to-treat').iCheck('uncheck'); $('#treat_notifications_notifications_{{ notification.id }}').iCheck('check'); return false;" type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#treatNotificationsModal">
                              <i class="fa fa-gear"></i> {{ 'notification.treat'|trans }}
                            </button>
                            {{ include('@EMSAdminUI/bootstrap5/elements/object-views-button.html.twig', {
                                object: notification.revision.buildObject,
                                contentType: notification.revision.contentType,
                                environment: notification.environment,
                                ouuid: notification.revision.ouuid,
                                currentTemplate: notification.template,
                            }) }}
                        </div>

                    </td>
                </tr>
            {% endfor %}
        </table>
        </div>
        <div class="">
            <div class="btn-group">
                <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal" data-bs-target="#treatNotificationsModal">
                  <i class="fa fa-gear"></i> {{ 'notification.treat_selection'|trans }}
                </button>
            </div>
        </div>
    {% endif %}

    <!-- Modal -->
    <div class="modal fade" id="treatNotificationsModal" tabindex="-1" role="dialog" aria-labelledby="treatNotificationsModalLabel">
      <div class="modal-dialog" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h4 class="modal-title" id="treatNotificationsModalLabel">{{ 'notification.treat_selected'|trans }}</h4>
              <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'action.close'|trans({}, 'emsco-core') }}"></button>
          </div>
          <div class="modal-body">
              {{ form_row(treatform.response) }}
              {{ form_row(treatform.publishTo) }}
          </div>
          <div class="modal-footer">

            <div class="btn-group">
                  {{ form_widget(treatform.accept, {attr: {disabled: true}}) }}
                  {{ form_widget(treatform.reject) }}
            </div>
          </div>
        </div>
      </div>
    </div>

    {{ form_widget(treatform.notifications) }}
{{ form_end(treatform) }}
