{% use "@EMSAdminUI/inline-editor/render.html.twig" %}
{%- trans_default_domain 'ems-adminui-twigs' -%}
<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{{ 'inline_editor.title'|trans }}</title>
        <link rel="stylesheet" href="{{ asset('src/core/inline-editor/editor.ts.css', 'emsadminui') }}">
        {%- if vite.isDevServerRunning -%}
            <script type="module" src="{{- vite.devServerClient -}}"></script>
        {%- endif -%}
        <script src="{{ asset('src/core/inline-editor/editor.ts', 'emsadminui') }}" type="module"></script>
    </head>
    <body data-base-url="{{ baseUrl }}"
          data-search-api="{{ path('emsco_ajax_query_search')|e('html_attr') }}"
          data-init-upload="{{ path('emsco_file_data_init_upload') }}"
          data-hash-algo="{{ ems_hash_algo }}"
          data-wysiwyg-info="{{ emsco_wysiwyg_info()|json_encode|e('html_attr') }}">
        <div class="editor">
            <header class="editor-topbar d-flex align-items-center justify-content-between px-3">
                <div class="editor-title fw-bold">{{ 'inline_editor.title'|trans }}</div>
                <div class="d-flex gap-2 align-items-center">
                    <div class="editor-actions d-flex gap-2" data-editor-clear="true"></div>
                    <button type="button" class="btn btn-sm btn-secondary" data-editor-action="toggleSidebar">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-layout-sidebar-right-collapse"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M4 6a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2l0 -12" /><path d="M15 4v16" /><path d="M9 10l2 2l-2 2" /></svg>
                    </button>
                    <a href="{{ iframeUrl }}" class="text-white" data-editor-action="close">{{ 'inline_editor.action.exit'|trans }}</a>
                </div>
            </header>
            <div class="editor-body">
                <main class="editor-preview">
                    <div id="editor-toolbar"></div>
                    <iframe id="preview-iframe" src="{{ iframeUrl }}" data-prefix="{{ routePrefix }}" allow="fullscreen" allowfullscreen></iframe>
                </main>
                <aside class="editor-sidebar">
                    <div class="editor-sidebar-resize-handle"></div>
                    <div class="editor-sidebar-content" data-editor-clear="true"></div>
                </aside>
            </div>
        </div>
    </body>
</html>
