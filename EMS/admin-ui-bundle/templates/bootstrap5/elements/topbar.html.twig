{%- trans_default_domain 'emsco-core' -%}

<nav class="navbar navbar-expand bg-{{ theme_color }}" {{ theme_color_contrast == 'dark' ? 'data-bs-theme="dark"' }}>
    <a href="#" class="sidebar-toggle js-sidebar-toggle" data-widget="pushmenu" role="button" aria-label="{{ 'key.push_menu'|trans }}">
        <i class="hamburger align-self-center"></i>
    </a>
    <form class="d-none d-sm-inline-block" action="{{ path('ems_quick_search') }}" method="get">
        <div class="input-group input-group-navbar">
            <input class="form-control" type="search" name="q" placeholder="{{ 'key.search'|trans }}" aria-label="{{ 'key.search'|trans }}">
            <button class="btn" type="submit" aria-label="{{ 'key.show_search_form'|trans }}">
                <i class="fas fa-search align-middle"></i>
            </button>
        </div>
    </form>
    <div class="navbar-collapse collapse">
        <ul class="navbar-nav navbar-align">
            {% if app.user %}
                {{ render(controller('EMS\\CoreBundle\\Controller\\ChannelController::menu')) }}
                {{ render(controller('EMS\\CoreBundle\\Controller\\NotificationController::menuNotification')) }}
            {% endif %}

            <li class="nav-item"  id="system-messages">
                <a class="nav-link" data-bs-toggle="offcanvas" href="#control-sidebar" role="button" aria-controls="control-sidebar">
                    <i id="ajax-activity" class="fa fa-refresh"></i>
                    <span class="visually-hidden">{{ 'action.toggle_sidebar'|trans }}</span>
                    <span id="activity-counter" class="badge bg-{{ theme_color }} navbar-badge"></span>
                </a>
            </li>
            {% if app.user %}
                <li class="nav-item dropdown user-menu" data-testid="user-menu">
                    <a class="nav-link dropdown-toggle d-none d-sm-inline-block p-0" href="#" data-bs-toggle="dropdown">
                        {{ include('@EMSAdminUI/bootstrap5/elements/user-image.html.twig', {
                            class: 'rounded-circle avatar ms-3 img-fluid',
                            width: 37,
                            height: 37,
                        }) }}
                    </a>
                    <ul class="dropdown-menu dropdown-menu-end pt-0">
                        <li class="user-header bg-{{ theme_color }} p-2">
                            <div class="text-center">
                                {{ include('@EMSAdminUI/bootstrap5/elements/user-image.html.twig', {
                                    class: 'rounded-circle',
                                    width: 60,
                                    height: 60,
                                }) }}
                            </div>

                            <p class="text-white text-center mt-2 mb-0">
                                {{ 'user.logged_in.title'|trans({'%username%': app.user.username}, 'emsco-core') }}
                                <small>{{ 'user.logged_in.member_since'|trans({'%date%': app.user.created|date(date_time_format)}, 'emsco-core') }}</small>

                                <small class="d-block">
                                    {% for role in app.user.roles %}
                                        {{ role|trans({}, 'emsco-roles') }}{% if not loop.last %},{% endif %}
                                    {% endfor %}
                                </small>
                            </p>
                        </li>
                        <li class="pt-2">
                            <a href="{{ path(routes.USER_PROFILE) }}" class="dropdown-item"><i class="fa fa-user"></i> {{ 'user.profile.title'|trans({}, 'emsco-core') }}</a>
                        </li>
                        {% if is_granted('IS_IMPERSONATOR') %}
                            <li>
                                <a href="{{ path('emsco_user_index', {_switch_user: '_exit'}) }}" class="dropdown-item" data-testid="logout"><i class="fa fa-sign-out" aria-hidden="true"></i> {{ 'user.logout.exit'|trans({}, 'emsco-core') }}</a>
                            </li>
                        {% else %}
                            <li>
                                <a href="{{ path(routes.USER_LOGOUT) }}" class="dropdown-item" data-testid="logout"><i class="fa fa-sign-out" aria-hidden="true"></i> {{ 'user.logout.submit'|trans({}, 'emsco-core') }}</a>
                            </li>
                        {% endif %}
                    </ul>
                </li>
            {% endif %}
        </ul>
    </div>
</nav>
