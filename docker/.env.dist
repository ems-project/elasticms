# Project namespace (defaults to the current folder name if not set)
COMPOSE_PROJECT_NAME=ems-mono

OTEL_ENABLED=false

# Search stack's version
# Possible values:
# * elk8: Elasticsearch 8: default value
# * os2: OpenSearch 2
ELK_VERSION=elk8

# Just in order to avoid error messages
EMS_VERSION=7.0.0

POSTGRES_VERSION=17

###> Cluster's variables ###
# Set the cluster name
CLUSTER_NAME=ems-cluster
# Increase or decrease based on the available host memory (in bytes)
MEM_LIMIT=1073741824
###< Cluster's variables ###

###> OpenSearch 2 variables ###
# Version of Elastic products
OS2_STACK_VERSION=2.4.1
###< OpenSearch 2 variables ###

###> ELK8 variables ###
# Version of Elastic products
ELK8_STACK_VERSION=8.19.4
# Set to 'basic' or 'trial' to automatically start the 30-day trial
ELK8_LICENSE=basic
#ELK8_LICENSE=trial
###< ELK8 variables ###

###> symfony/mercure ###
MERCURE_JWT_KEY=3MVVIRhoV7MMfXjeLMUUeeV1Bi2xP4N5vQLNcImaj2s
MERCURE_EXTRA_DIRECTIVES='cors_origins http://localhost:8881 https://localhost:8881'
###> symfony/mercure ###

###> dev/sandbox ###
DOCKER_USER=1000
