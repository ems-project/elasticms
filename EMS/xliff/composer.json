{
    "name": "elasticms/xliff",
    "description": "Reusable XLIFF import/export library (XLIFF 1.2 + 2.2) for EMS.",
    "type": "library",
    "keywords": [
        "php",
        "xliff"
    ],
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "EMS Community",
            "homepage": "https://github.com/ems-project/elasticms/contributors"
        }
    ],
    "require": {
        "php": "^8.5",
        "ext-dom": "*",
        "elasticms/helpers": "7.3.*",
        "symfony/dom-crawler": "7.4.*",
        "symfony/property-access": "7.4.*"
    },
    "autoload": {
        "psr-4": {
            "EMS\\Xliff\\": "src/"
        }
    },
    "config": {
        "lock": false,
        "sort-packages": true
    }
}
