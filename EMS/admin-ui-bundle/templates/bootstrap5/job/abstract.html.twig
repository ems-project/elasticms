{% extends '@EMSAdminUI/bootstrap5/template/card.html.twig' %}
{% trans_default_domain 'ems-adminui-twigs' %}

{% block subtitle -%}
    {%- set subtitle = 'job.abstract.subtitle'|trans  -%}
    {{- parent() -}}
{%- endblock subtitle %}

{% block breadcrumb %}
    {% set breadcrumb = {
        ('icon.jobs'|trans): 'key.jobs'|trans,
        '#': block('title'),
    } %}
    {{ parent() }}
{% endblock breadcrumb %}