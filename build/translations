#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__.'/../vendor/autoload.php';

use App\Admin\Kernel;
use EMS\Helpers\Standard\Number;
use Symfony\Component\Console\Command\Command;
use Symfony\Component\Console\Helper\TableSeparator;
use Symfony\Component\Console\Input\InputInterface;
use Symfony\Component\Console\Input\InputOption;
use Symfony\Component\Console\Output\OutputInterface;
use Symfony\Component\Console\SingleCommandApplication;
use Symfony\Component\Console\Style\SymfonyStyle;
use Symfony\Component\DependencyInjection\Container;
use Symfony\Component\Dotenv\Dotenv;
use Symfony\Component\Finder\Finder;
use Symfony\Component\HttpKernel\Bundle\BundleInterface;
use Symfony\Component\Stopwatch\Stopwatch;
use Symfony\Component\Translation\Catalogue\TargetOperation;
use Symfony\Component\Translation\Dumper\XliffFileDumper;
use Symfony\Component\Translation\Dumper\YamlFileDumper;
use Symfony\Component\Translation\Extractor\ExtractorInterface;
use Symfony\Component\Translation\MessageCatalogue;
use Symfony\Component\Translation\MessageCatalogueInterface;
use Symfony\Component\Translation\Reader\TranslationReaderInterface;
use Symfony\Component\Translation\Util\ArrayConverter;
use Symfony\Component\Translation\Writer\TranslationWriter;
use Symfony\Component\Yaml\Yaml;

use function Symfony\Component\String\u;

/**
 * @param list<BundleInterface> $bundles
 */
function extractCatalogue(SymfonyStyle $io, Container $container, array $bundles): MessageCatalogue
{
    $extractedCatalogue = new MessageCatalogue('und');
    $finder = new Finder()
            ->ignoreUnreadableDirs()
            ->ignoreVCSIgnored(true)
            ->notPath('/src/(Command|DependencyInjection|Entity|Repository)')
            ->in(\array_merge(...\array_map(
                static fn (BundleInterface $bundle) => [$bundle->getPath().'/src', $bundle->getPath().'/templates'],
                $bundles
            )));

    $extractors = [
        ['Parsing php files', '*.php', $container->get('translation.extractor.php_ast')],
        ['Parsing twig files', '*.twig', $container->get('twig.translation.extractor')],
    ];

    foreach ($extractors as [$title, $name, $extractor]) {
        /* @var ExtractorInterface $extractor */
        $io->writeln($title);
        $files = (clone $finder)->name($name);

        $progressBar = $io->createProgressBar($files->count());
        foreach ($files as $file) {
            $extractor->extract($file->getRealPath(), $extractedCatalogue);
            $progressBar->advance();
        }

        $progressBar->finish();
        $io->newLine();
    }
    $io->newLine();

    $validationDomain = $container->hasParameter('validator.translation_domain')
            ? $container->getParameter('validator.translation_domain')
            : 'validators';

    if (\is_string($validationDomain) && 'validators' !== $validationDomain) {
        $extractedCatalogue->add($extractedCatalogue->all('validators'), $validationDomain);
    }

    return $extractedCatalogue;
}

/**
 * @param list<BundleInterface> $bundles
 * @param list<string>          $domains
 *
 * @return array{
 *     rows: list<array{0: string, 1: string, 2: string, 3: string|null}>,
 *     summary: array<string, array{used: int, unused: int, new: int}>,
 *     unused: array<string, list<array{key: string, message: string|null}>>,
 * }
 */
function buildLocale(
    SymfonyStyle $io,
    Container $container,
    string $locale,
    array $bundles,
    array $domains,
    MessageCatalogue $extractedCatalogue,
    bool $write,
    string $format,
): array {
    $io->writeln(\sprintf('Build catalogue: %s', $locale));

    /** @var TranslationReaderInterface $reader */
    $reader = $container->get('translation.reader');

    $currentCatalogue = new MessageCatalogue($locale);
    $domainToBundleDir = [];
    foreach ($bundles as $bundle) {
        $bundleDir = $bundle->getPath();
        $bundleCatalogue = new MessageCatalogue($locale);
        $reader->read($bundleDir.'/translations', $bundleCatalogue);
        foreach ($bundleCatalogue->getDomains() as $bundleDomain) {
            $domainToBundleDir[$bundleDomain] ??= $bundleDir;
            $currentCatalogue->add($bundleCatalogue->all($bundleDomain), $bundleDomain);
        }
    }

    $catalogueDomains = $currentCatalogue->getDomains();
    foreach ($domains as $domain) {
        if (!\in_array($domain, $catalogueDomains, true)) {
            throw new \RuntimeException(\sprintf('Invalid domain: %s', $domain));
        }
    }

    if (0 === \count($domains)) {
        $domains = $catalogueDomains;
    }

    $filterCurrentCatalogue = new MessageCatalogue($locale);
    $filterExtractedCatalogue = new MessageCatalogue($locale);
    foreach ($domains as $domain) {
        $domainIntl = $domain.MessageCatalogueInterface::INTL_DOMAIN_SUFFIX;

        if ($intlMessages = $currentCatalogue->all($domainIntl)) {
            $filterCurrentCatalogue->add($intlMessages, $domainIntl);
        }
        if ($messages = \array_diff($currentCatalogue->all($domain), $intlMessages)) {
            $filterCurrentCatalogue->add($messages, $domainIntl);
        }

        $filterExtractedCatalogue->add($extractedCatalogue->all($domain), $domainIntl);
    }

    $operation = new TargetOperation($filterCurrentCatalogue, $filterExtractedCatalogue);
    /** @var MessageCatalogue $result */
    $result = $operation->getResult();

    if (0 === \count($result->all())) {
        throw new \RuntimeException('No translations found');
    }

    $sortedMessages = new MessageCatalogue($result->getLocale());
    foreach ($result->all() as $domain => $domainMessages) {
        \ksort($domainMessages);
        $sortedMessages->add($domainMessages, $domain.MessageCatalogueInterface::INTL_DOMAIN_SUFFIX);
    }

    if ($write) {
        $io->writeln('Writing translations');

        $translationWriter = new TranslationWriter();
        $translationWriter->addDumper('xlf', new XliffFileDumper());
        $translationWriter->addDumper('yml', new class extends YamlFileDumper {
            public function formatCatalogue(MessageCatalogue $messages, string $domain, array $options = []): string
            {
                return Yaml::dump(
                    input: ArrayConverter::expandToTree($messages->all($domain)),
                    inline: 5,
                    flags: Yaml::DUMP_MULTI_LINE_LITERAL_BLOCK
                );
            }
        });

        $messagesByBundleDir = [];
        foreach ($domains as $domain) {
            $bundleDir = $domainToBundleDir[$domain] ?? $bundles[0]->getPath();
            $domainIntl = $domain.MessageCatalogueInterface::INTL_DOMAIN_SUFFIX;
            $messagesByBundleDir[$bundleDir][$domainIntl] = $sortedMessages->all($domainIntl);
        }

        foreach ($messagesByBundleDir as $bundleDir => $domainMessages) {
            $bundleCatalogue = new MessageCatalogue($locale);
            foreach ($domainMessages as $domain => $messages) {
                $bundleCatalogue->add($messages, $domain);
            }

            $translationWriter->write($bundleCatalogue, $format, match ($format) {
                'yml' => [
                    'path' => $bundleDir.'/translations',
                    'as_tree' => true,
                    'inline' => 5,
                ],
                'xlf' => [
                    'path' => $bundleDir.'/translations',
                    'version' => '1.2',
                    'default_locale' => 'en',
                ],
            });
        }
    }

    $rows = [];
    $summary = [];
    $unused = [];
    foreach ($domains as $domain) {
        $domainObsoleteKeys = \array_keys($operation->getObsoleteMessages($domain));
        \sort($domainObsoleteKeys);
        foreach ($domainObsoleteKeys as $key) {
            $rows[$domain][] = ['<fg=red>unused</>', $domain, $key, $filterCurrentCatalogue->get($key, $domain)];
            $unused[$domain][] = ['key' => $key, 'message' => $filterCurrentCatalogue->get($key, $domain)];
        }

        $domainNewKeys = \array_keys($operation->getNewMessages($domain));
        \sort($domainNewKeys);
        foreach ($domainNewKeys as $key) {
            $rows[$domain][] = ['<fg=blue>new</>', $domain, $key, null];
        }

        $allKeys = \array_diff(\array_keys($operation->getMessages($domain)), $domainNewKeys);
        \sort($allKeys);
        foreach ($allKeys as $key) {
            $message = u($operation->getResult()->get($key, $domain))
                ->collapseWhitespace()
                ->truncate(50, ' ...');

            $rows[$domain][] = ['<fg=green>used</>', $domain, $key, $message->toString()];
        }

        $summary[$domain] = [
            'used' => \count($allKeys),
            'unused' => \count($domainObsoleteKeys),
            'new' => \count($domainNewKeys),
        ];
    }

    return [
        'rows' => \array_reduce($rows, static fn ($carry, $item) => \array_merge($carry, $item, [new TableSeparator()]), []),
        'summary' => $summary,
        'unused' => $unused,
    ];
}

$command = static function (InputInterface $input, OutputInterface $output): int {
    $stopWatch = new Stopwatch();
    $stopWatch->start('build');

    $io = new SymfonyStyle($input, $output);
    $io->title('Build: extract translations');

    $locales = $input->getOption('locale');
    $bundleNames = $input->getOption('bundle');
    $domains = $input->getOption('domain');
    $write = $input->getOption('write');
    $format = $input->getOption('format');

    if (!\in_array($format, ['yml', 'xlf'], true)) {
        throw new \RuntimeException('Invalid format');
    }

    $io->section('Booting admin kernel');
    new Dotenv()->load(__DIR__.'/../elasticms-admin/.env');
    $adminKernel = new Kernel('test', true);
    $adminKernel->boot();
    /** @var Container $container */
    $container = $adminKernel->getContainer()->get('test.service_container');

    $bundles = \array_map(static fn (string $name) => $adminKernel->getBundle($name), $bundleNames);

    $io->listing([
        \sprintf('Locales: %s', \implode(', ', $locales)),
        \sprintf('Domains: %s', \implode(', ', $domains)),
        \sprintf('Bundles: %s', \implode(', ', \array_map(static fn (BundleInterface $bundle) => $bundle->getPath(), $bundles))),
    ]);

    $io->section('Extracting translation keys from code');
    $extractedCatalogue = extractCatalogue($io, $container, $bundles);

    $io->section('Build');
    $allResults = [];
    foreach ($locales as $locale) {
        $allResults[$locale] = buildLocale($io, $container, $locale, $bundles, $domains, $extractedCatalogue, $write, $format);
    }

    foreach ($allResults as $locale => $result) {
        $io->newLine();

        if ($io->isVerbose()) {
            $rows = $result['rows'];
            if (0 === \count($rows)) {
                continue;
            }
            $rows = \array_slice($rows, 0, -1);

            $io
                    ->createTable()
                    ->setHeaderTitle(\sprintf('Info (%s)', $locale))
                    ->setHeaders(['State', 'Domain', 'Id', \sprintf('Message (%s)', $locale)])
                    ->setRows($rows)
                    ->render();

            continue;
        }

        $io->writeln(\sprintf('<info>%s</info>', $locale));
        foreach ($result['summary'] as $domain => $counts) {
            $io->writeln(\sprintf(
                '  %s: used %d, unused %d, new %d',
                $domain,
                $counts['used'],
                $counts['unused'],
                $counts['new']
            ));

            foreach ($result['unused'][$domain] ?? [] as $unused) {
                $io->writeln(\sprintf('    <fg=red>unused</> %s: %s', $unused['key'], $unused['message']));
            }
        }
    }

    $buildStopWatch = $stopWatch->stop('build');
    $io->newLine();
    $io->listing([
        \sprintf('Duration: %d s', $buildStopWatch->getDuration() / 1000),
        \sprintf('Memory: %s', Number::formatBytes($buildStopWatch->getMemory())),
    ]);

    return Command::SUCCESS;
};

new SingleCommandApplication()
        ->setName('Build: extract translations')
        ->addOption('locale', 'l', InputOption::VALUE_REQUIRED | InputOption::VALUE_IS_ARRAY, 'locale(s)', ['nl', 'fr', 'en'])
        ->addOption('bundle', 'b', InputOption::VALUE_REQUIRED | InputOption::VALUE_IS_ARRAY, 'bundle(s) to scan for usage; each domain is written back to the bundle it was read from', ['EMSCoreBundle', 'EMSAdminUIBundle'])
        ->addOption('write', null, InputOption::VALUE_NONE, 'write translations')
        ->addOption('domain', 'd', InputOption::VALUE_OPTIONAL | InputOption::VALUE_IS_ARRAY, 'domains', ['emsco-core', 'emsco-validation'])
        ->addOption('format', null, InputOption::VALUE_REQUIRED, 'format (yml or xlf)', 'yml')
        ->setCode($command)
        ->run();
