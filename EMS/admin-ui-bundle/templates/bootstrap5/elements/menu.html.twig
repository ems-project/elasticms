{% block sidebarMenu %}
    {# @var menu \EMS\CoreBundle\Core\UI\MenuEntry #}
    {% trans_default_domain 'ems-adminui-twigs' %}
    <li class="sidebar-item">
        <a href="{{ menu.hasChildren ? '#' : path(menu.route, menu.routeParameters) }}" class="sidebar-link{% if menu.color %}  text-{{ menu.color }}{% endif %}{% if menu.hasChildren %} collapsed{% endif %}" {% if menu.hasChildren %}data-bs-target="#nav-{{ menu.label|ems_slug }}" data-bs-toggle="collapse"{% endif %}>
            <i class="align-middle {{ menu.icon }}"></i>&nbsp;
            <span class="align-middle">
                {{ menu.labelTranslation is not null ? menu.labelTranslation|trans : menu.label }}
                {% if menu.hasBadge %}
                    <span class="sidebar-badge badge {{ menu.badgeColor ? 'bg-' ~ menu.badgeColor : 'bg-primary' }}">{{ menu.badge }}</span>
                {% endif %}
            </span>
        </a>
        {% if menu.hasChildren %}
            <ul id="nav-{{ menu.label|ems_slug }}" class="sidebar-dropdown list-unstyled collapse">
                {% for menu in menu.children %}
                    {{ block('sidebarMenu') }}
                {% endfor %}
            </ul>
        {% endif %}
    </li>
{% endblock sidebarMenu %}
