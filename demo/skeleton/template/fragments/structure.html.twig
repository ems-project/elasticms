{% extends '@EMSCH/template/variables.twig' %}
{% set rawData = section|emsch_get(['paths', 'structure']).source %}
{% set paths = rawData.paths|default([])|filter(p => p.locale == locale)|ems_array_key('uid') %}
{% set structure = rawData.structure|default("{}")|ems_json_menu_nested_decode %}
{% set urls = {} %}

{% set baseUrl = '' %}
{% if app.request.server.all['EMSCO_INSTANCE_ID']|default(false) %}
    {% set baseUrl = "/channel/#{trans_default_domain}" %}
{% endif %}

{% set sections = emsch_search('section', {
    query: {
        terms: {
            _contenttype: ['section'],
        },
    },
    _source: ['label', 'menu', 'structure', 'paths'],
    size: 100,
}, cache: true).hits.hits|default([])|filter(p => p._source.menu|default(false))|map(p => {
    id: p._id,
    contenttype: p._source._contenttype,
    label: p._source.label,
    menu: p._source.menu,
    structure: p._source.structure,
    paths: p._source.paths|default([]),
})|ems_array_key('menu') %}



{% set pages = emsch_search(['page', 'link'], {
    query: {
        exists: {
            field: 'menu',
        },
    },
    _source: ['menu',"#{locale}.target"],
    size: 1000,
}, cache: true).hits.hits|default([])|map(p => {menu: p._source.menu, target: p._source.(locale)|default({}).target|default(null)})|ems_array_key('menu') %}

{% for item in structure %}
    {% set pathInfo = paths.(item.id)|default(false) %}
    {% if pathInfo and pages.(item.id) is defined %}
        {% set urls = urls|merge({(item.id): pages.(item.id).target ? pages.(item.id).target : path('emsch_path', {path: pathInfo.path})}) %}
    {% endif %}
    {% if item.type == 'section' and sections.(item.id) %}
        {% set paths = paths|merge(sections.(item.id).paths|filter(p => p.locale == locale)|ems_array_key('uid')) %}
        {% do item.setChildren(sections.(item.id).structure|default('{}')|ems_json_menu_nested_decode.children) %}
    {% endif %}
{% endfor %}

