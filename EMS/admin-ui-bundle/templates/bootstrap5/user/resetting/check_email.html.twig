{%- trans_default_domain 'emsco-core' -%}
{% extends '@EMSAdminUI/bootstrap5/base/admin.html.twig' %}

{% block title %}{{ 'title.reset_password'|trans }}{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-12">
            <div class="card card-{{ theme_color }}">
                <div class="card-header with-border">
                    <h3 class="card-title">{{ 'title.reset_password'|trans }}</h3>
                </div>
                <div class="card-body">
                    <p>{{ 'message.reset_password_check_email'|trans({'tokenLifetime': (tokenLifetime / 3600)})|nl2br }}</p>
                </div>
            </div>
        </div>
    </div>
{% endblock body %}
