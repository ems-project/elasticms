{% extends '@EMSAdminUI/bootstrap5/view/custom/abstract.html.twig' %}

{% block body %}

<div class="row">

	<div class="col-md-12">
		<div class="box box-primary">
			<div class="box-header with-border">
				<h3 class="box-title">Configuration</h3>
			</div>
			<!-- /.box-header -->

			<!-- form start -->
			{{ form_start(form) }}

				<div class="box-body">

				<div class="table-responsive">
						<table class="table table-bordered">
                <tbody><tr>
                  <td>&nbsp;</td>
                  <td width="66%">{{ form_row(form.columnCriteria) }}</td>
                </tr>
                <tr>
                  <td>{{ form_row(form.rowCriteria) }}</td>
                  <td>
                  	{% if form.category is defined %}
							{{ form_row(form.category) }}
					{% endif %}
				</td>
                </tr>
              </tbody></table></div>
					<div class="" id="criterion">
						{{ form_widget(form.criterion) }}
					</div>
				</div>
				<!-- /.box-body -->
				<div class="box-footer">
                    {{ form_row(form.manage) }}
				</div>
            {{ form_end(form) }}
		</div>
	</div>
</div>

<div class="row">
	<div class="col-md-12" id="table_container">
	</div>
</div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('src/criteria-view.js', 'emsadminui') }}" type="module"></script>
{% endblock %}
