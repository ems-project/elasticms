{% extends '@EMSAdminUI/bootstrap5/base/admin.html.twig' %}{% trans_default_domain 'EMSCoreBundle' %}

{% block title %}{{ 'data.add.title'|trans({'%content_type%': contentType.name}) }}{% endblock %}
{% block pagetitle %}{{ 'data.add.title'|trans({'%content_type%': contentType.name}) }}{% endblock %}
{% block subtitle %}<small>{{ 'data.add.subtitle'|trans({'%object_name%': contentType.singularName}) }}</small>{% endblock %}

{% block body %}

<div class="row">
    <div class="col-md-6">
        <div class="card card-warning card-outline">
            <div class="card-header">
                <h3 class="card-title"><i class="fa fa-warning"></i> {{ 'notice_card.title'|trans }}</h3>
            </div>
            <!-- /.box-header -->
            <div class="card-body">
                <p>
                    {{ 'data.add.notice.draft_not_indexed'|trans({'%content_type%': contentType.name})|raw }}
                </p>
                <p>
                    {{ 'data.add.notice.ouuid'|trans|raw }}
                </p>
            </div>
            <!-- /.box-body -->
        </div>
    </div>
    <div class="col-md-6">
        <!-- general form elements -->
        <div class="card card-{{ theme_color }} card-outline card-outline-tabs">
            <div class="card-header">
                <h3 class="card-title">{{ 'data.add.new_title'|trans({'%content_type%': contentType.name}) }}</h3>
            </div>
            <!-- /.box-header -->
            <!-- form start -->
            {{ form_start(form) }}

                <div class="card-body">
                    {{ form_row(form.ouuid) }}

                </div>
                <!-- /.box-body -->
                <div class="card-footer">
                    {{ form_widget(form.save) }}
                </div>
            {{ form_end(form) }}

        </div>
        <!-- /.box -->
    </div>
</div>
{% endblock %}
