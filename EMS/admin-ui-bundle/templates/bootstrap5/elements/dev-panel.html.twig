{#
    Temporary developer-only tooling (ROLE_SUPER_ADMIN only) for quickly
    previewing sidebar/theme states via localStorage, without touching
    server config. Not translated on purpose - safe to remove later.
#}
<li class="nav-item dropdown" data-testid="dev-panel">
    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown" data-bs-auto-close="outside" title="Dev panel">
        <i class="fa fa-flask"></i>
    </a>
    <div class="dropdown-menu dropdown-menu-end p-3" style="min-width: 220px;">
        <div class="dev-panel-label">Mode</div>
        <div class="d-flex mb-3">
            <button type="button" class="mode-btn" data-mode="light">Light</button>
            <button type="button" class="mode-btn" data-mode="dark">Dark</button>
        </div>

        <div class="dev-panel-label">Theme color (sidebar/topbar)</div>
        <div class="d-flex gap-2 mb-3">
            {# AdminLTE2 skin colors only - matches the loop in css/admin/components/_dev-panel.scss #}
            {% for color in ['light-blue', 'purple', 'green', 'red', 'yellow'] %}
                <button type="button" class="skin-swatch" data-skin="{{ color }}" title="{{ color }}"></button>
            {% endfor %}
        </div>

        <div class="dev-panel-label">Sidebar</div>
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="devSidebarCollapsed">
            <label class="form-check-label" for="devSidebarCollapsed">Collapsed</label>
        </div>
    </div>
</li>
