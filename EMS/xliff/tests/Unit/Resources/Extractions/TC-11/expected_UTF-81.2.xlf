          <group restype="x-html-ul" id="tu56" resname="/html/body/div/ul">
            <trans-unit restype="listitem" id="tu58" resname="/html/body/div/ul/li[1]">
              <source xml:lang="en" id="tu57">1.078,95 EUR van het 1<g id="g59" ctype="x-html-sup">ste</g> kwartaal van 2018 tot het 3<g id="g60" ctype="x-html-sup">de</g> kwartaal van 2018 (alle categorieën); </source>
              <target xml:lang="fr" state="new"/>
            </trans-unit>
            <trans-unit restype="listitem" id="tu62" resname="/html/body/div/ul/li[2]">
              <source xml:lang="en" id="tu61">1.100,49 EUR van het 4<g id="g63" ctype="x-html-sup">de</g> kwartaal van 2018 tot het 1<g id="g64" ctype="x-html-sup">ste</g> kwartaal van 2020 (alle categorieën); </source>
