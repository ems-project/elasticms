{% extends '@EMSAdminUI/bootstrap5/job/abstract.html.twig' %}
{% trans_default_domain 'ems-adminui-twigs' %}

{% block title %}{{ 'job.add.title'|trans }}{% endblock %}

{% block form %}
    <div class="row">
        <div class="col-md-10">{{ form_row(form.command) }}</div>
        <div class="col-md-2">{{ form_row(form.tag) }}</div>
    </div>
{% endblock form %}

{% block footer %}
    {% set footer %}
        {{ form_widget(form.launch, {
            'attr': { 'class': 'btn btn-primary btn-sm float-end' },
            'icon': 'fa fa-save',
        }) }}
    {% endset %}
    {{ parent() }}
{% endblock footer %}
