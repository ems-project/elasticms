{% extends '@EMSAdminUI/bootstrap5/base/admin.html.twig' %}{% trans_default_domain 'emsco-core' %}

{% block extraheader %}{{ header|raw }}{% endblock %}

{% block title %}{{ 'view.title'|trans({
    'name': view.label,
    'label': view.name,
    'plural': view.contentType.pluralName,
    'singular': view.contentType.singularName,
}) }}{% endblock %}
{% block pagetitle %}{{ block('title') }}{% endblock %}

{% block body %}
<div class="box with-border">
	<div class="box-body" style="display: block;">
		{{ render|raw }}
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ javascript|raw }}
{% endblock %}