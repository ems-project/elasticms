{% trans_default_domain 'emsco-core' %}
<div class="card">
    <div class="card-header">
        <i class="{{ icon }}"></i>
        <h3 class="card-title">{{ title }}</h3>
        <div class="btn-group float-end">
            <a class="btn btn-xs btn-primary" href="{{ path(add_route) }}"><i class="fa fa-plus"></i> {{ add_label }}</a>
        </div>
    </div>
    <!-- /.box-header -->
    {% if entities|length %}
        <div class="card-body no-padding">
            {{ form_start(form) }}
            <ol class="nested-sortable vertical">
                {% for entity in entities %}
                    <li id="{{ entity.id }}" data-id="{{ entity.id }}">
                        <div class="box-header ui-sortable-handle">
                            <div class="float-end box-tools ui-sortable-handle">
                                <div class="btn-group">
                                    {{ include('@EMSAdminUI/bootstrap5/elements/get-button.html.twig', {
                                        url: path(edit_route, {id: entity.id}),
                                        label: 'Edit',
                                        icon: 'pencil',
                                    }) }}
                                </div>
                            </div>
                            <h3 class="box-title">{{ entity.name }}</h3>
                        </div>
                    </li>
                {% endfor %}
            </ol>
            <div>
                <div class="card-footer">
                    <div class="btn-group">
                        {{ form_widget(form.reorder) }}
                    </div>
                </div>
            </div>
            {{ form_end(form) }}
            <!-- /.box-footer -->
        </div>
    {% else %}
        <div class="card-body">
            {{ missing_label }}
        </div>
    {% endif %}
    <!-- /.box-body -->
</div>
