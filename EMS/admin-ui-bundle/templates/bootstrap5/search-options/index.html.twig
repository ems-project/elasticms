{% trans_default_domain 'emsco-core' %}{% extends '@EMSAdminUI/bootstrap5/base/admin.html.twig' %}
{% block title %} {{ 'search_options.title'|trans }} {% endblock %}
{% block pagetitle %} {{ 'search_options.title'|trans }} {% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb float-sm-end">
        <li class="breadcrumb-item"><i class="fa fa-search"></i> {{ 'search_options.title'|trans }}</li>
       </ol>
{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-6">
            {{ include('@EMSAdminUI/bootstrap5/entity/list-entities.html.twig', {
                entities: sortOptions,
                icon: 'fa fa-sort-alpha-asc',
                title: 'search_options.sort.title'|trans,
                add_label: 'search_options.sort.add'|trans,
                missing_label: 'search_options.sort.missing'|trans,
                add_route: 'ems_search_sort_option_new',
                edit_route: 'ems_search_sort_option_edit',
                form: sortOptionReorderForm,
            }) }}
        </div>
        <div class="col-md-6">
            {{ include('@EMSAdminUI/bootstrap5/entity/list-entities.html.twig', {
                entities: aggregateOptions,
                icon: 'fa fa-th',
                title: 'search_options.aggregate.title'|trans,
                add_label: 'search_options.aggregate.add'|trans,
                missing_label: 'search_options.aggregate.missing'|trans,
                add_route: 'ems_search_aggregate_option_new',
                edit_route: 'ems_search_aggregate_option_edit',
                form: aggregateOptionReorderForm,
            }) }}
        </div>
        <div class="col-md-6">
            {{ include('@EMSAdminUI/bootstrap5/entity/list-entities.html.twig', {
                entities: searchFieldOptions,
                icon: 'fa fa-th',
                title: 'search_options.field.title'|trans,
                add_label: 'search_options.field.add'|trans,
                missing_label: 'search_options.field.missing'|trans,
                add_route: 'ems_search_field_option_new',
                edit_route: 'ems_search_field_option_edit',
                form: searchFieldOptionReorderForm,
            }) }}
        </div>
    </div>
{% endblock %}
