{%- set url = null -%}
{%- if attribute(source, locale) is defined and attribute(source, locale).target is defined -%}
    {%- set url = attribute(source, locale).target -%}
{%- endif -%}
{%- if url -%}
    {{- url -}}
{%- else -%}
    {{- path('emsch_missing_translation', {contentType: 'link', ouuid: id, _locale: locale}) -}}
{%- endif -%}
