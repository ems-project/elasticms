{% extends '@EMSAdminUI/bootstrap5/base/admin.html.twig' %}{% trans_default_domain 'ems-adminui-twigs' %}

{% block title %}{{ 'user.edit.title'|trans({'%display_name%': user.displayName}) }}{% endblock %}
{% block pagetitle %}{{ 'user.edit.title'|trans({'%display_name%': user.displayName}) }}{% endblock %}
{% block subtitle %}<small>{{ 'user.administration'|trans }}</small>{% endblock %}

{% block body %}
    <div class="card card-{{ theme_color }} card-outline">
        <div class="card-header">
            <h3 class="card-title">{{ 'user.edit.card_title'|trans({'%username%': user.username}) }}</h3>
        </div>
        {{ form_start(form, {action: path('emsco_user_edit', {user: user.id})}) }}
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    {{ form_row(form.username) }}
                    {{ form_row(form.displayName) }}
                    {{ form_row(form.locale) }}
                    {{ form_row(form.localePreferred) }}
                    {{ form_row(form.email) }}
                    {{ form_row(form.emailNotification) }}
                    {{ form_row(form.enabled) }}
                    {% if form.circles is defined %}
                        {{ form_row(form.circles) }}
                    {% endif %}
                    {{ form_row(form.wysiwygProfile) }}
                {{ form_row(form.expirationDate) }}</div>
                <div class="col-md-6">
                    {% if form.userOptions.custom_options is defined %}
                        <div class="row">
                            {{ form_row(form.userOptions.custom_options) }}
                        </div>
                    {% endif %}
                    {{ form_row(form.userOptions) }}
                    {% if form.group is defined %}
                        {{ form_row(form.group) }}
                    {% endif %}
                    {{ form_row(form.userRoles) }}
                </div>
            </div>
        </div>
        <div class="card-footer">
            {{ form_row(form.update) }}
        </div>
        {{ form_end(form) }}
    </div>
    <!-- /.box -->
{% endblock body %}
