{% extends '@EMSAdminUI/bootstrap5/template/card.html.twig' %}
{% trans_default_domain 'ems-adminui-twigs' %}

{% block header %}
    {% set header %}
        <div class="btn-group float-end">
            <a class="btn-add btn btn-xs btn-success" data-bs-target="i18n-bs-content">
                <i class="fa fa-plus-square"></i>
                {{ 'key.add_translation'|trans }}
            </a>
        </div>
    {% endset %}
    {{ parent() }}
{% endblock header %}

{% block footer %}
    {% set footer %}
        <div class="btn-group">
            <button type="submit" id="i18n_save" name="i18n_save" class="btn-primary btn-sm btn">
                <span class="fa fa-save"></span>&nbsp;
                {{ actionLabel|default('key.save'|trans) }}
            </button>
            <a class="btn btn-sm" href="{{ path('emsco_i18n_index') }}">
                <i class="fa fa-remove"></i>
                {{ 'key.cancel'|trans }}
            </a>
        </div>
        </div>
    {% endset %}
    {{ parent() }}
{% endblock footer %}

{% block javascripts %}
    <script src="{{ asset('src/i18n.js', 'emsadminui') }}" type="module"></script>
{% endblock %}
