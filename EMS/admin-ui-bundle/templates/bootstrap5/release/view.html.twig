{% extends '@EMSAdminUI/bootstrap5/base/admin.html.twig' %}
{% trans_default_domain 'emsco-core' %}

{% block title %}{{ 'title.release_documents'|trans }}{% endblock %}
{% block pagetitle %}{{ block('title') }}{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb float-sm-end">
        <li class="breadcrumb-item"><a href="{{ path('emsco_release_index') }}"><i class="fa fa-cube}"></i> {{ 'key.releases'|trans }}</a></li>
        <li class="breadcrumb-item">{{ block('title') }}</li>
       </ol>
{% endblock %}

{% block body %}
    {% set toolbar %}
        {{ include('@EMSAdminUI/bootstrap5/elements/get-button.html.twig', {
            url: path('emsco_release_index'),
            label: 'key.all_releases'|trans,
            icon: 'cube',
        }) }}
    {% endset %}

    {% if form is not null %}
        {% form_theme form '@EMSAdminUI/bootstrap5/form/forms.html.twig' %}
        {{ form(form, {
            toolbar: toolbar,
        }) }}
    {% endif %}
{% endblock %}
