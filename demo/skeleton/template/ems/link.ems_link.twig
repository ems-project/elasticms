{%- set url = null -%}
{%- if source.(locale) is defined and source.(locale).target is defined -%}
    {%- set url = source.(locale).target -%}
{%- endif -%}
{%- if url -%}
    {{- url -}}
{%- else -%}
    {{- path('emsch_missing_translation', {contentType: 'link', ouuid: id, _locale: locale}) -}}
{%- endif -%}
