{% extends '@EMSAdminUI/bootstrap5/job/abstract.html.twig' %}
{% trans_default_domain 'ems-adminui-twigs' %}

{% block body %}
    <div class="container-fluid">
        <div class="row" {% if launchJob %}data-start-job-url="{{ path('emsco_job_start', {job: job.id}) }}"{% endif %}>
            <div class="col-md-3">
                {{ block('job_info') }}
            </div>
            <div class="col-md-9">
                {{ parent() }}
            </div>
        </div>
    </div>
{% endblock body %}

{% block job_info %}
    {% set list = [{
        icon: 'fa fa-clock',
        label: 'job.started'|trans,
        value: job.created|date(date_time_format),
    },{
        icon: 'fa fa-hourglass',
        label: 'job.modified'|trans,
        value: job.modified|date(date_time_format),
    },{
        icon: 'fa fa-user',
        label: 'job.user'|trans,
        value: job.user|emsco_display_name,
    },{
        icon: 'fa fa-terminal',
        label: 'job.command'|trans,
        content: job.command|default('list'),
        contentClass: 'console'
    },{
        icon: 'fa fa-percent',
        label: 'job.progress'|trans,
        value: job.done ? 'job.completed'|trans : "#{job.progress}%",
    }] %}
    {% if job.tag %}
        {% set list = list|merge([{
            icon: 'fa fa-tag',
            label: 'job.tag'|trans,
            value: job.tag,
        }]) %}
    {% endif %}
    <div class="card card-{{ theme_color }} card-outline shadow">
        <div class="card-header">
            <h2 class="text-center card-title"><i class="fa fa-info"></i> Meta information</h2>
        </div>
        <div class="card-body">
            <ul class="list-group list-group-unbordered">
                {% for item in list %}
                    <li class="list-group-item">
                        <div class="d-flex w-100 justify-content-between">
                            <b><i class="{{ item.icon }}"></i> {{ item.label }}</b>
                            {% if item.value is defined %}<span>{{ item.value }}</span>{% endif %}
                        </div>
                        {% if item.content is defined %}
                            <p class="mt-1 mb-0 {{ item.contentClass|default('') }}">
                                {{ item.content }}
                            </p>
                        {% endif %}
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
{% endblock job_info %}


{% block header %}
    <div class="card-header">
        <h2 class="card-title">
            <i class="fa fa-gear{% if not job.done %} fa-spin{% endif %}"></i>
            {{ 'job.output'|trans({job_id: job.id}) }}
        </h2>
    </div>
{% endblock %}

{% block content %}
    <div class="console">
        {{ output|raw|nl2br }}
    </div>
{% endblock content %}

{% block footer %}
<div class="card-footer clearfix">
    <div class="btn-group float-end">
        {% if not job.done %}
            {% include '@EMSAdminUI/bootstrap5/elements/get-button.html.twig' with {
                'url':  path('job.status', {'job': job.id}),
                'label': 'Refresh page',
                'icon': 'refresh'
            }%}
        {% endif %}
        {% if is_granted('ROLE_ADMIN') %}
            {% include '@EMSAdminUI/bootstrap5/elements/get-button.html.twig' with {
                'url':  path('job.index'),
                'label': 'Job\'s list',
                'icon': 'chevron-circle-right'
            }%}
            {% include '@EMSAdminUI/bootstrap5/elements/post-button.html.twig' with {
                'url':  path('job.delete', {'job': job.id}),
                'message': 'Do you confirm ?',
                'label': 'Delete',
                'icon': 'trash'
            }%}
        {% endif %}
    </div>
</div>
{% endblock footer %}
