{%- trans_default_domain 'emsco-core' -%}
<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" name="viewport">
    <meta name="robots" content="noindex, nofollow">

    <title>{{ ems_shortname|striptags }}: {% block title %}elasticMS{% endblock %}</title>

    {% block frontend_application_css %}
        <link rel="stylesheet" href="{{ asset('app.css', 'emscore') }}">
    {% endblock %}
    {%- if theme_color %}
        <link rel="stylesheet" href="{{ asset(theme_color~'.css', 'emscore') }}">
    {%- else -%}
        <link rel="stylesheet" href="{{ asset('blue.css', 'emscore') }}">
    {%-  endif %}

    <link rel="stylesheet" href="{{ asset('src/core-bundle.ts.css', 'emsadminui') }}">

    {%- block stylesheets %}{% endblock %}

	<link rel="icon" sizes="128x128" type="image/png" href="{{ path('core-favicon') }}" />
    <link rel="apple-touch-icon" sizes="128x128" type="image/png" href="{{ path('core-apple-touch-icon') }}">
    <link rel="manifest" href="{{ path('core-site-webmanifest') }}" />

    {%- block extraheader %}{% endblock %}
</head>

{%- set wysiwygInfo = emsco_wysiwyg_info() -%}
<body class="hold-transition skin-{{ theme_color }} {% if app.user %}{% if app.user.layoutBoxed %}layout-boxed{% endif %}{% if app.user.sidebarCollapse %} sidebar-collapse{% endif %}{% if app.user.sidebarMini %} sidebar-mini{% endif %}{% endif %}"
      data-hash-algo="{{ ems_hash_algo|e('html_attr') }}"
      data-status-url="{{ path('elasticsearch.status', {_format: 'json'})|e('html_attr') }}"
      data-wysiwyg-type-filters="{{ wysiwygInfo.linkTypes|json_encode|e('html_attr') }}"
      data-wysiwyg-info="{{ wysiwygInfo|json_encode|e('html_attr') }}"
      data-search-api="{{ path('elasticsearch.api.search')|e('html_attr') }}"
      data-asset-path="{{ asset('')|e('html_attr') }}"
      data-init-upload="{{ path('emsco_file_data_init_upload')|e('html_attr') }}"
      data-file-view="{{ path('ems.file.view', { sha1: '__file_identifier__', name: '__file_name__' })|e('html_attr') }}"
      data-file-extract="{{ path('ems_file_extract', { sha1: '__file_identifier__', name: '__file_name__' })|e('html_attr') }}"
      data-file-extract-forced="{{ path('ems_file_extract_forced', { sha1: '__file_identifier__', name: '__file_name__' })|e('html_attr') }}"
      data-image-max-size="{{ image_max_size }}">
<div class="wrapper">

  <header class="main-header">

    <a href="{{ path('homepage') }}" class="logo">
      <span class="logo-mini">{{ ems_shortname|raw }}</span>
      <span class="logo-lg">{{ ems_name|raw }}</span>
    </a>

    <nav class="navbar navbar-static-top" role="navigation">
      <a href="#" class="sidebar-toggle" data-toggle="push-menu" role="button" id="sidebar-toggle-button" data-testid="sidebar-menu-collapse">
        <span class="sr-only">Toggle navigation</span>
      </a>
      <div class="navbar-custom-menu">
        <ul class="nav navbar-nav">
          {% if app.user %}

		{% if app.user %}
		  {{ render(controller('EMS\\CoreBundle\\Controller\\ChannelController::menu')) }}
		  {{ render(controller('EMS\\CoreBundle\\Controller\\NotificationController::menuNotification')) }}
        {% endif %}

          <li class="dropdown tasks-menu" id="system-messages">
            <a href="#" class="dropdown-toggle" data-toggle="control-sidebar" data-testid="tasks-menu">
              <i id="ajax-activity" class="fa fa-refresh"></i>
              <span class="label label-danger"></span>
            </a>
          </li>

          <li class="dropdown user user-menu">
            <a href="#" class="dropdown-toggle" data-toggle="dropdown" data-testid="user-menu">
              	{% include '@EMSCore/elements/user-image.html.twig' with {
					'class': 'user-image'
				} %}
              <span class="hidden-xs">{{ app.user.displayName }}</span>
            </a>
            <ul class="dropdown-menu">
              <li class="user-header">
                {% include '@EMSCore/elements/user-image.html.twig' with {
					'class': 'img-circle'
				} %}
                <p>
                  {{ 'message.logged_in_as'|trans({'username': app.user.username}, 'emsco-core') }}
                  <small>{{ 'message.member_since'|trans({'date': app.user.created|date(date_time_format)}, 'emsco-core') }}</small>
                  <small>
                  	{% for role in app.user.roles %}
                  		{{ (role|replace({'ROLE_': 'ROLE.'}) ~ '.label')|lower|trans([], 'emsco-core') }}{% if not loop.last %},{% endif %}
                  	{% endfor %}
                  </small>
                </p>
              </li>
              <li class="user-footer">
                <div class="pull-left" data-testid="user-footer-edit-profile">
                  <a href="{{ path(routes.USER_PROFILE) }}" class="btn btn-default btn-flat">{{ 'title.profile'|trans({}, 'emsco-core') }}</a>
                </div>
                <div class="pull-right" data-testid="user-footer-logout">
               		{% if is_granted('IS_IMPERSONATOR') %}
               			<a href="{{ path('emsco_user_index', {'_switch_user': '_exit'}) }}" class="btn btn-default btn-flat" data-testid="logout">{{ 'action.exit'|trans({}, 'emsco-core') }}</a>
               		{% else %}
               			<a href="{{ path(routes.USER_LOGOUT) }}" class="btn btn-default btn-flat" data-testid="logout">{{ 'action.sign_out'|trans({}, 'emsco-core') }}</a>
               		{% endif %}
                </div>
              </li>
            </ul>
          </li>
          {% else %}
          <li>
            <a href="{{ path(routes.USER_LOGIN) }}" ><span class="glyphicon glyphicon-lock"></span> {{ 'action.sign_in'|trans({}, 'emsco-core') }}</a>
          </li>
          {% endif %}
        </ul>
      </div>
    </nav>
  </header>
  <twig:ems_layout_sidebar />
  <div class="content-wrapper">
    <section class="content-header">
      <h1>
        {% block pagetitle %}<strong>elastic</strong>MS{% endblock %}
        {% block subtitle %}{% endblock %}
      </h1>
      	{% block breadcrumb %}{% endblock %}
    </section>

    <section class="content">
    	<div id="flashbags">{% include '@EMSCore/core/alerts.twig' %}</div>
      {% block body %}{% endblock %}

		<div class="modal fade" id="data-out-of-sync" tabindex="-1" role="dialog" aria-labelledby="myModalOutOfSync">
		  <div class="modal-dialog" role="document">
		    <div class="modal-content">
		      <div class="modal-header">
		        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
		        <h4 class="modal-title" id="myModalOutOfSync">
							<strong>Out of sync</strong>
				</h4>
		      </div>
		      <div class="modal-body">
				There is something wrong with this application. Please reload the page.
			  </div>
		      <div class="modal-footer">
		      	<div class="btn-group">
			        <button type="button" class="btn btn-primary" onclick="location.reload();"><i class="fa fa-refresh"></i> Reload</button>
		      	</div>
		      </div>
		    </div>
		  </div>
		</div>

		<div class="modal fade" id="modal-notifications" tabindex="-1" role="dialog" aria-labelledby="myModalNotifications">
		  <div class="modal-dialog" role="document">
		    <div class="modal-content">
		      <div class="modal-header">
		        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
		        <h4 class="modal-title" id="myModalNotifications">
							<strong>Notifications</strong>
				</h4>
		      </div>
		      <div class="modal-body">
			  </div>
		      <div class="modal-footer">
		      	<button id="modal-notification-close-button" type="button" class="btn btn-primary"><i class="fa fa-close"></i> Close</button>
			  </div>
		    </div>
		  </div>
		</div>
    </section>
  </div>

  <footer class="main-footer no-print">
    {% if app.user %}
        <div class="pull-right">
            {{ 'core.version'|trans({ 'core': ems_version('core'), 'symfony': ems_version('symfony') }, 'emsco-core') }}
        </div>
        <a href="http://www.elasticms.eu/">elastic<b>ms</b></a>
    {% endif %}
  </footer>
  <aside class="control-sidebar control-sidebar-dark">
    <ul class="nav nav-tabs nav-justified control-sidebar-tabs">
      <li class="active"><a href="#control-sidebar-home-tab" data-toggle="tab"><i class="fa fa-home"></i></a></li>
      <li><a href="#control-sidebar-settings-tab" data-toggle="tab"><i class="fa fa-terminal"></i></a></li>
    </ul>
    <div class="tab-content">
      <div class="tab-pane active" id="control-sidebar-home-tab">
        <h3 class="control-sidebar-heading">Recent Activity</h3>
        <ul class="control-sidebar-menu" id="activity-log">
        </ul>
      </div>
      <div class="tab-pane" id="control-sidebar-settings-tab">
          <h3 class="control-sidebar-heading">Last commands</h3>
          <ul class="control-sidebar-menu" id="commands-log">
              {% if app.user %}
                  {{ render(controller('EMS\\CoreBundle\\Controller\\LayoutController::jobs', {
                      'username' : app.user.username
                  } ) ) }}
              {% endif %}
          </ul>
      </div>
    </div>
  </aside>
  <div class="control-sidebar-bg"></div>

  <div class="modal fade" id="waitingModal" tabindex="-1" role="dialog" aria-labelledby="waitingModalLabel">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h3 class="modal-title" id="waitingModalLabel">Loading information</h3>
      </div>
      <div class="modal-body">
        <div class="progress progress-striped active" style="margin-bottom:0;"><div class="progress-bar" style="width: 100%"></div></div>
      </div>
    </div>
  </div>
</div>
</div>
    {% embed '@EMSCore/core/modal.html.twig' with {'id': 'ajax-modal'} %}{% endembed %}
    {% embed '@EMSCore/core/modal.html.twig' with {'id': 'pick-file-server-modal'} %}{% endembed %}
    <script src="{{ asset('src/core-bundle.ts', 'emsadminui') }}" type="module"></script>
    {% block frontend_application_js %}{#ok#}
        <script src="{{ asset('app.js', 'emscore') }}"></script>
    {% endblock %}
	{% block javascripts %}{% endblock %}
</body>
</html>