{% extends '@EMSAdminUI/bootstrap5/job/abstract.html.twig' %}
{% trans_default_domain 'emsco-core' %}

{% block body %}
    <div class="container-fluid">
        <div class="row" {% if launchJob %}data-start-job-url="{{ path('emsco_job_start', {job: job.id}) }}"{% endif %}>
            <div class="col-md-3">
                {{ block('job_info') }}
            </div>
            <div class="col-md-9">
                {{ parent() }}
            </div>
        </div>
    </div>
{% endblock body %}

{% block job_info %}
    {% set list = [{
        icon: 'fa fa-user',
        label: 'job.user'|trans,
        value: job.user|emsco_display_name,
    }, {
        icon: 'fa fa-terminal',
        label: 'job.command'|trans,
        content: job.command|default('list'),
        contentClass: 'console',
    }, {
        icon: 'fa fa-clock',
        label: 'job.started'|trans,
        value: job.created|date(date_time_format),
    }, {
        icon: 'fa fa-hourglass',
        label: 'job.modified'|trans,
        value: job.modified|date(date_time_format),
    }, {
        icon: 'fa fa-percent',
        label: 'job.progress'|trans,
        value: job.done ? 'job.completed'|trans : "#{job.progress}%",
    }] %}
    {% if job.tag %}
        {% set list = list|merge([{
            icon: 'fa fa-tag',
            label: 'job.tag'|trans,
            value: job.tag,
        }]) %}
    {% endif %}

    {% set listGroup %}
        {{ include('@EMSAdminUI/bootstrap5/core/list-group.html.twig', {
            list: list,
        }) }}
    {% endset %}

    {% with {
        content: listGroup,
        cardTitle: 'job.info'|trans,
        cardTitleIcon: 'fa fa-info',
    } %}
        {{ block('card', '@EMSAdminUI/bootstrap5/template/card.html.twig') }}
    {% endwith %}
{% endblock job_info %}

{% block header %}
    {% set cardTitleIcon = html_classes('fa', 'fa-gear', {
        'fa-spin': job.done,
    }) %}
    {% set cardTitle = 'job.output'|trans({job_id: job.id}) %}
    {{ parent() }}
{% endblock %}

{% block content %}
    <div class="console">
        {{ output|raw|nl2br }}
    </div>
{% endblock content %}

{% block footer %}
    {% set footer %}
        <div class="btn-group float-end">
            {% if not job.done %}
                {{ include('@EMSAdminUI/bootstrap5/elements/get-button.html.twig', {
                    url: path('emsco_job_status', {job: job.id}),
                    label: 'button.reload_page'|trans,
                    icon: 'refresh',
                }) }}
            {% endif %}
            {% if is_granted('ROLE_ADMIN') %}
                {{ include('@EMSAdminUI/bootstrap5/elements/get-button.html.twig', {
                    url: path('emsco_job_index'),
                    label: 'job.list'|trans,
                    icon: 'chevron-circle-right',
                }) }}
                {{ include('@EMSAdminUI/bootstrap5/elements/post-button.html.twig', {
                    url: path('emsco_job_delete', {job: job.id}),
                    message: 'button.confirm'|trans,
                    label: 'button.delete'|trans,
                    icon: 'trash',
                }) }}
            {% endif %}
        </div>
    {% endset %}
    {{ parent() }}
{% endblock footer %}
