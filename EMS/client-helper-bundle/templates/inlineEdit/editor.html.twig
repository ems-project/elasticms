<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Inline Editor</title>
    <link rel="stylesheet" href="{{ asset('src/inline-editor/editor.ts.css', 'emsclienthelper') }}">
    {%- if vite.isDevServerRunning -%}
        <script type="module" src="{{- vite.devServerClient -}}"></script>
    {%- endif -%}
    <script src="{{ asset('src/inline-editor/editor.ts', 'emsclienthelper') }}" type="module"></script>
</head>
<body>
<div class="editor" id="editor">
    <header class="editor-topbar">
        <strong>Inline Editor</strong>
        <div class="editor-actions">
            <button class="btn" id="btn-edit"><i class="fas fa-pen"></i> Edit</button>
            <a href="{{ url }}" class="btn"><i class="fas fa-close"></i> Close</a>
        </div>
    </header>
    <div class="editor-body" id="editorBody">
        <main class="editor-preview">
            <iframe id="preview-iframe" src="{{ url }}"></iframe>
        </main>
        <aside class="editor-sidebar" id="sidebar">
            <div class="editor-resize-handle" id="resizeHandle"></div>
        </aside>
    </div>
</div>
</body>
</html>
