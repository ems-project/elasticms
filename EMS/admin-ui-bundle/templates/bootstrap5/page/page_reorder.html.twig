{% extends '@EMSAdminUI/bootstrap5/page/page.html.twig' %}

{% trans_default_domain 'emsco-core' %}

{% macro reorder_items(parent, contentType) %}
    {% for child in parent.children|filter(child => not child.deleted) %}
        <li id="{{ child.id }}" data-id="{{ child.id }}">
            <div class="card-header">
                <strong>{{ child.name }}</strong> {{ child.type }}
                <div class="btn-group float-end">
                    {% if contentType %}
                        <a class="btn btn-xs btn-primary" href="{{ path('emsco_admin_content_type_edit_field', {contentType: contentType.id, field: child.id}) }}">
                            <i class="fa fa-edit"></i>
                            {{ 'message.edit_field_name'|trans({'name': child.name}) }}
                        </a>
                    {% endif %}
                </div>
            </div>
            {% if (child.type ~ '::isContainer')|emsco_call_user_func %}
                <ol data-parent-id="{{ child.id }}">
                    {% if child.children|length > 0 %}
                        {{ _self.reorder_items(child, contentType) }}
                    {% endif %}
                </ol>
            {% endif %}
        </li>
    {% endfor %}
{% endmacro %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card card-outline card-yellow mb-4 shadow">
                    {{ form_start(form) }}
                    <div class="card-body">
                        <ol class="nested-sortable vertical" id="root-list" data-nested-max-level="15" data-nested-is-tree="true">
                            {{ _self.reorder_items(entity.fieldType, contentType|default(null)) }}
                        </ol>
                    </div>
                    <div class="card-footer">
                        {{ form_widget(form.reorder) }}
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}