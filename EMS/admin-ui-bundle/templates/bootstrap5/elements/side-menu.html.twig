{% trans_default_domain 'emsco-core' %}

<form class="px-3 pt-3 pb-3 sidebar-search" action="{{ path('ems_quick_search') }}" method="get">
    <div class="input-group input-group-sidebar">
        <input class="form-control" type="search" name="q" placeholder="{{ 'key.search'|trans }}" aria-label="{{ 'key.search'|trans }}">
        <button class="btn" type="submit" aria-label="{{ 'key.show_search_form'|trans }}">
            <i class="fas fa-search align-middle"></i>
        </button>
    </div>
</form>

<ul class="sidebar-nav">
    {% for item in menu|default([])|filter(p => p.hasChildren) %}
        <li class="sidebar-header">{{ item.title|trans }}</li>
        {% for menu in item.children %}
            {{ block('sidebarMenu', '@EMSAdminUI/bootstrap5/elements/menu.html.twig') }}
        {% endfor %}
    {% endfor %}
</ul>

{% if status is defined %}
    {% set statusTitle = 'cluster.status'|trans({color: status}, 'emsco-core') %}
    <a href="{{ path('elasticsearch.status') }}" id="status-overview" class="sidebar-status" title="{{ statusTitle }}">
        {%- with {
            title: statusTitle,
            status: status,
        } -%}
            {{ block('status', '@EMSAdminUI/bootstrap5/elasticsearch/status.html.twig') }}
        {%- endwith -%}
    </a>
{% endif %}
