{% extends '@EMSAdminUI/bootstrap5/template/card.html.twig' %}
{% trans_default_domain 'ems-adminui-twigs' %}

{% block title %}{{ 'log.title'|trans({created: log.created|date(date_time_format)}) }}{% endblock %}

{% block body %}
<div class="row justify-content-md-center">
    <div class="col-md-4">
        {{ parent() }}
    </div>
</div>
{% endblock body %}

{% block content %}
    {% set items = [
        {icon: 'fas fa-user', label: 'key.username'|trans, value: log.username|default('key.not-applicable'|trans)|emsco_display_name},
        {icon: 'fas fa-user-secret', label: 'key.impersonator'|trans, value: log.impersonator|default('key.not-applicable'|trans)|emsco_display_name},
        {icon: 'fas fa-clock', label: 'key.created'|trans, value: log.created|date(date_time_format)},
        {icon: 'fas fa-message', label: 'key.message'|trans, value: log.message|default('')},
        {icon: 'fas fa-traffic-light', label: 'key.severity'|trans, value: "#{log.levelName} (#{log.level})"},
        {icon: 'fas fa-road-circle-check', label: 'key.channel'|trans, value: log.channel|default('')},
        {icon: 'fa-solid fa-file-lines', label: 'key.context'|trans, content: log.context|json_encode(constant('JSON_PRETTY_PRINT')), contentTag: 'pre'},
        {icon: 'fa-solid fa-table', label: 'key.extra'|trans, content: log.extra|json_encode(constant('JSON_PRETTY_PRINT')), contentTag: 'pre'},
    ] %}
    {{ include('@EMSAdminUI/bootstrap5/core/list-group.html.twig', {list: items}) }}
{% endblock content %}

{% block footer %}
    {% set footer %}
        {{ include('@EMSAdminUI/bootstrap5/elements/post-button.html.twig', {
            url: path('emsco_log_delete', {log: log.id}),
            label: 'action.delete'|trans({}, 'emsco-core'),
            message: 'type.delete_confirm'|trans({type: 'log'}, 'emsco-core'),
            icon: 'trash',
            btnType: 'outline-danger',
        }) }}
    {% endset %}
    {{ parent() }}
{% endblock footer %}
