{% extends '@EMSAdminUI/bootstrap5/user/user.html.twig' %}
{% trans_default_domain 'emsco-core' %}

{% block body %}
    {% set toolbar %}
        <a class="btn btn-primary" href="{{ path('emsco_user_add') }}"><i class="fa fa-plus"></i> {{ 'key.add_user'|trans }}</a>
        <a class="btn btn-outline-primary" href="{{ path('emsco_user_spreadsheet_export', {_format: 'xlsx'}) }}"><i class="fa fa-file-excel-o"></i> {{ 'key.excel_export'|trans }}</a>
        <a class="btn btn-outline-primary" href="{{ path('emsco_user_spreadsheet_export', {_format: 'csv'}) }}"><i class="fa fa-file-text-o"></i> {{ 'key.csv_export'|trans }}</a>
    {% endset %}

    {% form_theme form '@EMSAdminUI/bootstrap5/form/forms.html.twig' %}
    {{ form(form, {
        reorder_label: 'user.index.reorder',
        toolbar: toolbar,
    }) }}

    {{ parent() }}
{% endblock %}
