{%- trans_default_domain 'ems-adminui-elements' -%}
<div class="card collapsed-card">
    <div class="card-header">
        <h3 class="card-title">
            {% if icon is defined %}<i class="{{ icon }}"></i>{% endif %}
            {% block title %}{% endblock title %}
        </h3>
        <div class="card-tools">
            <button type="button" class="btn" data-card-widget="collapse" title="{{ 'action.collapse'|trans({}, 'emsco-core') }}">
                <i class="fas fa-plus"></i>
            </button>
        </div>
    </div>
    <div class="card-body">
        {% block body %}{% endblock body %}
    </div>
</div>
