{% set w = width|default(128) %}
{% set h = height|default(128) %}
<span class="{{ html_classes('avatar-wrap', class|default('')) }}" style="width:{{ w }}px;height:{{ h }}px">
    {% if app.user %}
        <img class="avatar-img" src="https://www.gravatar.com/avatar/{{ app.user.email|lower|ems_md5 }}?s=256&d=mp"
             alt="{{ app.user.displayName }}" width="{{ w }}" height="{{ h }}">
    {% endif %}
</span>