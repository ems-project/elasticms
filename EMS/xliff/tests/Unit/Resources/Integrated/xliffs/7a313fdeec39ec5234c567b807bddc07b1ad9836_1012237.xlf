      <group resname="[description]" id="grp7">
        <trans-unit restype="x-html-p" id="tu8" resname="/html/body/p[1]">
          <source xml:lang="nl"> Deze doelgroepvermindering is in elke regio aangepast en/of vervangen. U vindt meer op de desbetreffende pagina's. </source>
          <target xml:lang="de" state="final"> Diese Zielgruppenermäßigung wurde in jeder Region angepasst und/oder ersetzt. Weitere Informationen finden Sie auf den entsprechenden Seiten. </target>
        </trans-unit>
        <trans-unit restype="x-html-p" id="tu9" resname="/html/body/p[2]">
