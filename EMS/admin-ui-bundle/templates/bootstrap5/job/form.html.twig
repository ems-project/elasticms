{% use '@EMSAdminUI/bootstrap5/form/fields.html.twig' %}

{% block _job_command_row %}
    <div class="col-md-10">{{ block('form_row') }}</div>
{% endblock _job_command_row %}

{% block _job_tag_row %}
    <div class="col-md-2">{{ block('form_row') }}</div>
{% endblock _job_tag_row %}

{% block _job_launch_widget %}
    {{ form_widget(form, {
        attr: {class: 'btn btn-primary btn-sm float-end'},
        icon: 'fa fa-save',
    }) }}
{% endblock _job_launch_widget %}
