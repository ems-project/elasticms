<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
        http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <defaults public="false" />

        <service id="ems_common.runner.manager" class="EMS\CommonBundle\Runner\RunnerManager">
            <argument type="service" id="logger" />
            <argument type="tagged" tag="ems_common.runner.factory"/>
            <argument type="string">%ems_common.runners%</argument>
        </service>

        <service id="ems_common.runner.factory.openshift" class="EMS\CommonBundle\Runner\Factory\OpenShiftFactory">
            <argument type="service" id="logger" />
            <argument type="service" id="ems_common.composer.info"/>
            <tag name="ems_common.runner.factory" alias="openshift"/>
        </service>
    </services>
</container>
