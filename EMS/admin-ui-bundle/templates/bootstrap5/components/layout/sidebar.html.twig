{% trans_default_domain 'emsco-core' %}

{%- set status = this.status -%}

<nav id="sidebar" class="sidebar">
    <div class="sidebar-content">
        {%- if app.user -%}
            <form class="px-3 pt-3 pb-3 sidebar-search" action="{{ path('ems_quick_search') }}" method="get">
                <div class="input-group input-group-sidebar">
                    <input class="form-control" type="search" name="q" placeholder="{{ 'key.search'|trans }}" aria-label="{{ 'key.search'|trans }}">
                    <button class="btn px-2 d-flex align-items-center justify-content-center" type="submit" aria-label="{{ 'key.show_search_form'|trans }}">
                        <i class="fas fa-search align-middle"></i>
                    </button>
                </div>
            </form>
        {%- endif -%}

        <ul class="sidebar-nav">
            {% for item in this.menus|filter(p => p.hasChildren) %}
                <li class="sidebar-header">{{ item.title|trans }}</li>
                {% for menu in item.children %}
                    {{ _self.item(this, menu) }}
                {% endfor %}
            {% endfor %}
        </ul>
    </div>
</nav>

{% macro item(component, menu, parentSlug = '') %}
    {% set menuLabel = menu.label is ems_translatable_message ? menu.label|trans : menu.label %}
    {% set menuColor = menu.color|default('') %}
    {% set slug = menuLabel|ems_slug %}
    {% set path = menu.route is not null ? path(menu.route, menu.routeParameters) : null %}
    {% set active = component.isPathActive(path) %}
    <li class="{{ html_classes({'sidebar-item': true, active: active}) }}">
        <a href="{{ menu.hasChildren ? '#' : path|default('#') }}"
           class="{{ html_classes('sidebar-link', {("text-#{menuColor}"): menuColor != '', collapsed: menu.hasChildren and not active}) }}"
           {% if menu.hasChildren %}
               data-bs-target="#nav-{{ parentSlug }}{{ slug }}"
               data-bs-toggle="collapse"
               aria-expanded="{{ active ? 'true' : 'false' }}"
           {% endif %}
           data-testid="menu-item-{{ parentSlug }}{{ slug }}">
            <i class="align-middle {{ menu.icon }}"></i>
            <span class="align-middle">
                {{ menuLabel }}
                {% if menu.hasBadge %}
                    <span class="sidebar-badge badge {{ menu.badgeColor ? 'bg-' ~ menu.badgeColor : 'bg-primary' }}">{{ menu.badge }}</span>
                {% endif %}
            </span>
        </a>
        {% if menu.hasChildren %}
            <ul id="nav-{{ parentSlug }}{{ slug }}" class="sidebar-dropdown list-unstyled collapse{% if active %} show{% endif %}">
                {% for child in menu.children %}
                    {{ _self.item(component, child, parentSlug ~ slug ~ '-') }}
                {% endfor %}
            </ul>
        {% endif %}
    </li>
{% endmacro %}
