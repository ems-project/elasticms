{% extends '@EMSAdminUI/bootstrap5/base/admin.html.twig' %}

{% trans_default_domain 'emsco-core' %}

{% block title %}{{ title|trans }}{% endblock %}
{% block pagetitle %}{{ pageTitle|default(title)|trans }}{% endblock %}

{% block body %}
    {% set widths = {
        narrow: 'col-12 col-md-8 col-lg-6 col-xl-5',
        medium: 'col-12 col-lg-8 col-xl-6',
        full: 'col-12',
    } %}
    <div class="row justify-content-center">
        <div class="{{ widths[width|default('full')] }}">
            {{ block('page_content') }}
        </div>
    </div>
{% endblock %}

{%- block page_content -%}
    {%- if datatable is defined -%}
        {{ block('render_datatable') }}
    {%- elseif datatables is defined -%}
        {{ block('render_datatables') }}
    {%- elseif form is defined -%}
        {{ block('render_form') }}
    {%- endif -%}
{%- endblock page_content -%}

{%- block render_datatable -%}
    {% set tableOptions = {} %}
    {% if datatable.icon is defined %}{% set tableOptions = tableOptions|merge({table_title_icon: datatable.icon}) %}{% endif %}
    {% if datatable.title is defined %}{% set tableOptions = tableOptions|merge({table_title: datatable.title|trans}) %}{% endif %}

    {% form_theme datatable.form '@EMSAdminUI/bootstrap5/form/forms.html.twig' %}
    <div class="card">
        <div class="card-body">
            {{ form(datatable.form, tableOptions) }}
        </div>
    </div>
{%- endblock render_datatable -%}

{% block render_datatables %}
    <div class="row">
        {% for datatable in datatables %}
            <div class="{{ datatables|length == 2 ? 'col-md-6' : 'col-md-12' }}">
                {{ block('render_datatable') }}
            </div>
        {% endfor %}
    </div>
{% endblock render_datatables %}

{%- block render_form -%}
    <div class="row">
        {%- if notice is defined -%}
            <div class="col-md-3">
                {{ include('@EMSAdminUI/bootstrap5/core/card.html.twig', {
                    header: 'key.notice'|trans({}, 'emsco-core'),
                    headerIcon: 'fa fa-warning',
                    content: notice|trans,
                }, with_context: false) }}
            </div>
        {%- endif -%}
        <div class="{{ notice is defined ? 'col-md-9' : 'col-md-12' }}">
            {{ form_start(form) }}
            {% embed '@EMSAdminUI/bootstrap5/core/card.html.twig' with {
                class: 'card-primary',
                form: form,
            } only %}
                {% block card_content %}
                    {{ form_errors(form) }}
                    <div class="d-flex flex-column gap-3">
                        {% for child in form|filter(c => c.vars.name not in ['save', 'cancel', 'save_close']) %}
                            {{ form_row(child) }}
                        {% endfor %}
                    </div>
                {% endblock %}
                {% block card_footer %}
                    {%- for button in form|filter(c => c.vars.name in ['save', 'cancel', 'save_close']) -%}
                        {{ form_widget(button) }}
                    {%- endfor -%}
                {% endblock %}
            {% endembed %}
            {{ form_end(form) }}
        </div>
    </div>
{%- endblock render_form -%}
