#!/usr/bin/env bash
set -eo pipefail

export DEBUG=${DEBUG:-false}
[[ "${DEBUG}" == "true" ]] && set -x

export ELASTICMS_CLI_JOB_COMMAND="$@"

# The early hooks (entrypoint.d) have already run: base-php's cli entrypoint
# sources them before it execs this script. Only the helper functions are
# loaded here -- they do not cross an exec.
source /usr/local/bin/container-entrypoint.d/entrypoint.d/00-functions.sh

log "INFO" "+---- ElasticMS CLI Container ( Cronjob ) configured succesfully -----"

exec elasticms-job "${ELASTICMS_CLI_JOB_COMMAND}"