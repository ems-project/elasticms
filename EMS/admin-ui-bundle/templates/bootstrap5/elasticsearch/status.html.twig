{% extends '@EMSAdminUI/bootstrap5/base/admin.html.twig' %}
{% trans_default_domain 'ems-adminui-twigs' %}

{% block title %}{{ title|trans }}{% endblock title %}
{% block pagetitle %}{{ block('title') }}{% endblock %}

{% block status -%}
    <i class="fa fa-circle fa-2xs text-{{ status }}"></i>  <span class="visually-hidden">{{ title }}</span>
{%- endblock status %}

{% block body %}
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-4">
                {{ block('cluster') }}
            </div>
            <div class="col-md-4">
                {{ block('certificate') }}
            </div>
            <div class="col-md-4">
                {{ block('asset_extractor') }}
            </div>
        </div>
    </div>
{% endblock body %}

{% block cluster %}
    {% set list = [{
        label: 'key.name'|trans,
        value: cluster.cluster_name|default(''),
    },{
        label: 'key.cluster_uuid'|trans,
        value: cluster.cluster_uuid|default(''),
    },{
        label: 'key.status'|trans,
        value: cluster.status|humanize,
    },{
        label: 'key.tagline'|trans,
        value: cluster.tagline|default(''),
    },{
        label: 'key.version'|trans,
        value: cluster.version.number|default(''),
    },{
        label: 'key.build_date'|trans,
        value: cluster.version.build_date|split('.')|first|date(date_time_format),
    },{
        label: 'key.lucene_version'|trans,
        value: cluster.version.lucene_version|default(''),
    },{
        label: 'key.number_of_nodes'|trans,
        value: cluster.number_of_nodes|default(''),
    },{
        label: 'key.number_of_data_nodes'|trans,
        value: cluster.number_of_data_nodes|default(''),
    },{
        label: 'key.active_primary_shards'|trans,
        value: cluster.active_primary_shards|default(''),
    },{
        label: 'key.active_shards'|trans,
        value: cluster.active_shards|default(''),
    },{
        label: 'key.initializing_shards'|trans,
        value: cluster.initializing_shards|default(''),
    },{
        label: 'key.unassigned_shards'|trans,
        value: cluster.unassigned_shards|default(''),
    },{
        label: 'key.delayed_unassigned_shards'|trans,
        value: cluster.delayed_unassigned_shards|default(''),
    },{
        label: 'key.number_of_pending_tasks'|trans,
        value: cluster.number_of_pending_tasks|default(''),
    },{
        label: 'key.task_max_waiting_in_queue_millis'|trans,
        value: "#{cluster.task_max_waiting_in_queue_millis} ms",
    },{
        label: 'key.active_shards_percent_as_number'|trans,
        value: "#{cluster.active_shards_percent_as_number}%",
    }] %}

    {% set listGroup %}
        {% include '@EMSAdminUI/bootstrap5/components/bootstrap/list-group.html.twig' with {
            'list':  list
        }%}
    {% endset %}

    {% with {
        content: listGroup,
        cardTitle: cluster.title,
        cardTitleIcon: 'fa fa-cubes fa-2x',
        theme_color: cluster.status,
    } %}
        {{ block('card', '@EMSAdminUI/bootstrap5/template/card.html.twig') }}
    {% endwith %}
{% endblock cluster %}

{% block certificate %}
    {% set list = [{
        label: 'key.status'|trans,
        value: certificate.status|humanize,
    }] %}
    {% if certificate.bits|default %}
        {% set list = list|merge([{
            label: 'key.bits'|trans,
            value: certificate.bits,
        }]) %}
    {% endif %}
    {% if certificate.key|default %}
        {% set list = list|merge([{
            label: 'key.public_key'|trans,
            content: certificate.key,
            contentTag: 'pre',
            link: path('ems_get_public_key'),
        }]) %}
    {% endif %}

    {% set listGroup %}
        {% include '@EMSAdminUI/bootstrap5/components/bootstrap/list-group.html.twig' with {
            'list':  list
        }%}
    {% endset %}

    {% with {
        content: listGroup,
        cardTitle: certificate.title,
        cardTitleIcon: 'fa fa-key fa-2x',
        theme_color: certificate.status,
    } %}
        {{ block('card', '@EMSAdminUI/bootstrap5/template/card.html.twig') }}
    {% endwith %}
{% endblock certificate %}

{% block asset_extractor %}
    {% set list = [{
        label: 'key.status'|trans,
        value: asset_extractor.status|humanize,
    }] %}
    {% if asset_extractor.client|default %}
        {% set list = list|merge([{
            label: 'key.client'|trans,
            value: asset_extractor.client,
        }]) %}
    {% endif %}
    {% if asset_extractor.content|default %}
        {% set list = list|merge([{
            label: 'key.content'|trans,
            value: asset_extractor.content,
        }]) %}
    {% endif %}

    {% set listGroup %}
        {% include '@EMSAdminUI/bootstrap5/components/bootstrap/list-group.html.twig' with {
            'list':  list
        }%}
    {% endset %}

    {% with {
        content: listGroup,
        cardTitle: asset_extractor.title,
        cardTitleIcon: 'fa-solid fa-file-export fa-2x',
        theme_color: asset_extractor.status,
    } %}
        {{ block('card', '@EMSAdminUI/bootstrap5/template/card.html.twig') }}
    {% endwith %}
{% endblock asset_extractor %}
