{% extends '@EMSAdminUI/bootstrap5/base/admin.html.twig' %}{% trans_default_domain 'ems-adminui-twigs' %}

{% block title %}{{ 'environment.align.title'|trans }}{% endblock %}
{% block pagetitle %}{{ 'environment.align.title'|trans }}{% endblock %}
{% block breadcrumb %}
    <ol class="breadcrumb float-sm-end">
        <li class="breadcrumb-item"><i class="fa fa-database"></i> {{ 'environment.plural'|trans }}</li>
        <li class="breadcrumb-item active">{{ 'environment.align.title'|trans }}</li>
    </ol>
{% endblock %}

{% block subtitle %}
<small>{{ 'environment.align.subtitle'|trans }}</small>
{% endblock %}

{% block body %}

<div class="row">
{{ form_start(form) }}
    <div class="col">
        <div class="card card-{{ theme_color }} card-outline">
            <div class="card-header">
                <h3 class="card-title">{{ 'environment.align.select_environments'|trans }}</h3>
            </div>
            <!-- /.box-header -->
            <!-- form start -->
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.environment) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_row(form.withEnvironment) }}
                    </div>
                </div>
            </div>
            <!-- /.box-body -->

            <div class="card-header">
                <h3 class="card-title">{{ 'key.filters'|trans }}</h3>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        {{ form_row(form.contentTypes) }}
                    </div>
                </div>
            </div>
            <!-- /.box-body -->

            <div class="card-footer">
                {{ form_row(form.compare) }}
            </div>
            {{ form_errors(form) }}
        </div>
    </div>

{% if results %}
    <div class="col">
        <div class="card card-{{ theme_color }} card-outline">
      <div class="card-header">
          {% set fromInMyCircles = environments[environment].circles|emsco_in_my_circles %}
          {% set toInMyCircles = environments[withEnvironment].circles|emsco_in_my_circles %}

        <h3 class="card-title">{{ 'environment.align.compare_title'|trans({'%environment%': environment, '%with_environment%': withEnvironment}) }}</h3> <small>{{ 'environment.align.difference_count'|trans({'%count%': total}) }}</small>

          {{ include('@EMSAdminUI/bootstrap5/elements/pagination.html.twig', {
                    lastPage: lastPage,
                    currentPage: page,
                    currentFilters: app.request.query,
                    paginationPath: paginationPath,
                    showAlwaysFirstAndLast: false,
                }) }}

      </div>
      <!-- /.box-header -->
      <div class="card-body no-padding">
              <div class="table-responsive">
        <table class="table dataTable">
          <thead>
          <tr>
            <th style="width: 10px">#</th>

            <th>
                <div class="icheck-primary text-center" title="{{ 'environment.align.checkbox-all'|trans }}">
                    <input type="checkbox" id="align-env-checkbox-all" data-grouped-checkbox-target=".item-to-align"/>
                    <label for="align-env-checkbox-all"><span class="visually-hidden">{{ 'environment.align.checkbox-all'|trans }}</span></label>
                </div>
            </th>
              {{ include('@EMSAdminUI/bootstrap5/elements/sortable-th.html.twig', {
                 title: 'key.content_type'|trans,
                 field: 'contentype',
            }) }}
              {{ include('@EMSAdminUI/bootstrap5/elements/sortable-th.html.twig', {
                 title: 'key.label'|trans,
                 field: 'label',
            }) }}

            <th><span class="badge bg-{{ environments[environment].color }}" title="{{ 'environment.align.circles'|trans }}">{{ environment }}</span></th>
            <th><span class="badge bg-{{ environments[withEnvironment].color }}" title="{{ 'environment.align.circles'|trans }}">{{ withEnvironment }}</span></th>
            <th>{{ 'key.actions'|trans }}</th>

          </tr>
          </thead>
          <tbody>
          {% for item in results %}
                  {% set data = (item.content_type_name ~ ':' ~ item.ouuid) %}
                  {% set minrev = item.minrevid|split('/') %}
                  {% set maxrev = item.maxrevid|split('/') %}
                  {% set defaultEnv = false %}
            {% for ct in contentTypes %}
                {% if ct.name == item.content_type_name %}
                    {% set defaultEnv = ct.environment %}
                {% endif %}
            {% endfor %}
            <tr>
              <td>{{ loop.index + ((page - 1) * paging_size) }}.</td>
              <td>
                  {% if (is_granted('ROLE_ALLOW_ALIGN') and is_granted(item.contentType.roles.publish)) %}
                    <div class="icheck-primary text-center" title="{{ 'environment.align.selected'|trans }}">
                        <input class="item-to-align" type="checkbox" id="compare_environment_form[item_to_align][{{ minrev[1] }}]" name="compare_environment_form[item_to_align][{{ minrev[1] }}]" value="{{ item.content_type_name }}:{{ item.ouuid }}">
                        <label for="compare_environment_form[item_to_align][{{ minrev[1] }}]"><span class="visually-hidden">{{ 'environment.align.selected'|trans }}</span></label>
                    </div>
                  {% endif %}
              </td>
              <td class="text-{{ item.color }}"><i class="{% if item.icon %}{{ item.icon }}{% else %}fa fa-book{% endif %}"></i> {{ item.content_type_singular_name }}</td>
              <td><span title='{{ item.ouuid }}'>{{ item.item_labelField }}</span></td>
              <td>
              {% if defaultEnv %}
                        {% if minrev[0] == fromEnv.id %}
                            {% if fromEnv.id == defaultEnv.id %}
                                <i class="fa fa-lock" aria-hidden="true"></i>
                            {% elseif minrev[2] >= maxrev[2] %}
                                <i class="fa fa-thumbs-o-up" aria-hidden="true"></i>
                            {% endif %}
                            {{ minrev[2]|date(date_time_format) }}
                            ({{ minrev[1] }})
                        {% elseif maxrev[0] == fromEnv.id %}
                            {% if fromEnv.id == defaultEnv.id %}
                                <i class="fa fa-lock" aria-hidden="true"></i>
                            {% elseif minrev[2] <= maxrev[2] %}
                                <i class="fa fa-thumbs-o-up" aria-hidden="true"></i>
                            {% endif %}
                            {{ maxrev[2]|date(date_time_format) }}
                            ({{ maxrev[1] }})
                        {% endif %}
                    {% endif %}
              {% if item.objectEnvironment %}
                  {{ include('@EMSAdminUI/bootstrap5/elements/object-toolbar.html.twig', {
                  object: item.objectEnvironment,
                  environment: fromEnv,
                  contentType: item.contentType,
                  recursiveView: true,
              }) }}
              {% for notification in item.revisionEnvironment.notifications %}
                {% if notification.status == 'pending' %}
                          <span class="label label-default"><i class="{{ notification.template.icon }}"></i> {{ notification.template.label }}</span>
                      {% endif %}
              {% endfor %}
              {% endif %}
              </td>
              <td>
                        {% if minrev[0] == withEnv.id %}
                            {% if withEnv.id == defaultEnv.id %}
                                <i class="fa fa-lock" aria-hidden="true"></i>
                            {% elseif minrev[2] >= maxrev[2] %}
                                <i class="fa fa-thumbs-o-up" aria-hidden="true"></i>
                            {% endif %}
                            {{ minrev[2]|date(date_time_format) }}
                            ({{ minrev[1] }})
                        {% elseif maxrev[0] == withEnv.id %}
                            {% if withEnv.id == defaultEnv.id %}
                                <i class="fa fa-lock" aria-hidden="true"></i>
                            {% elseif minrev[2] <= maxrev[2] %}
                                <i class="fa fa-thumbs-o-up" aria-hidden="true"></i>
                            {% endif %}
                            {{ maxrev[2]|date(date_time_format) }}
                            ({{ maxrev[1] }})
                        {% endif %}
                {% if item.objectWithEnvironment %}
                    {{ include('@EMSAdminUI/bootstrap5/elements/object-toolbar.html.twig', {
                    object: item.objectWithEnvironment,
                    environment: withEnv,
                    contentType: item.contentType,
                    recursiveView: true,
                  }) }}
                  {% for notification in item.revisionEnvironment.notifications %}
                      {% if notification.status == 'pending' %}
                          <span class="label label-default"><i class="{{ notification.template.icon }}"></i> {{ notification.template.label }}</span>
                      {% endif %}
                  {% endfor %}
                {% endif %}
              </td>
              <td>
                {% if is_granted('ROLE_ALLOW_ALIGN') and is_granted(item.contentType.roles.publish) %}
                    <div class="btn-group">

                            {% if defaultEnv and withEnv.id != defaultEnv.id and toInMyCircles %}
                                {% if minrev[0] == fromEnv.id %}
                                    <button type="submit" id="{{ minrev[1] }}" name="compare_environment_form[alignWith]" value="{{ minrev[1] }}" class="btn-primary btn-sm btn"><span class="fa fa-chevron-right"></span>&nbsp;{{ 'environment.align.align_with'|trans({'%environment%': withEnvironment, '%with_environment%': environment}) }}</button>
                                {% elseif maxrev[0] == fromEnv.id %}
                                    <button type="submit" id="{{ maxrev[1] }}" name="compare_environment_form[alignWith]" value="{{ maxrev[1] }}" class="btn-primary btn-sm btn"><span class="fa fa-chevron-right"></span>&nbsp;{{ 'environment.align.align_with'|trans({'%environment%': withEnvironment, '%with_environment%': environment}) }}</button>
                                {% endif %}
                            {% endif %}

                            {% if defaultEnv and fromEnv.id != defaultEnv.id and fromInMyCircles %}
                                {% if minrev[0] == withEnv.id %}
                                    <button type="submit" id="{{ minrev[1] }}" name="compare_environment_form[alignWith]" value="{{ minrev[1] }}" class="btn-danger btn-sm btn"><span class="fa fa-chevron-left"></span>&nbsp;{{ 'environment.align.align_with'|trans({'%environment%': environment, '%with_environment%': withEnvironment}) }}</button>
                                {% elseif maxrev[0] == withEnv.id %}
                                    <button type="submit" id="{{ maxrev[1] }}" name="compare_environment_form[alignWith]" value="{{ maxrev[1] }}" class="btn-danger btn-sm btn"><span class="fa fa-chevron-left"></span>&nbsp;{{ 'environment.align.align_with'|trans({'%environment%': environment, '%with_environment%': withEnvironment}) }}</button>
                                {% endif %}
                            {% endif %}
                    </div>
                {% endif %}

                  {% if minrev[1] != maxrev[1] %}
                      {{ include('@EMSAdminUI/bootstrap5/elements/get-button.html.twig', {
                          url: path('emsco_view_revisions', {
                              type: item.content_type_name,
                              ouuid: item.ouuid,
                              revisionId: minrev[1] > maxrev[1] ? minrev[1] : maxrev[1],
                              compareId: minrev[1] < maxrev[1] ? minrev[1] : maxrev[1],
                          }),
                          label: 'environment.align.compare'|trans,
                          icon: 'compress'}) }}
                  {% endif %}
              </td>
            </tr>
        {% endfor %}
        </tbody></table>
        </div>
      </div>
      {% if is_granted('ROLE_ALLOW_ALIGN') or lastPage > 1 %}
          <div class="box-footer">
            {% if is_granted('ROLE_ALLOW_ALIGN') %}
                  <div class="btn-group">
                      {% if toInMyCircles %}
                        <button type="submit" name="compare_environment_form[alignRight]" class="btn-primary btn-md btn"><span class="fa fa-chevron-right"></span>&nbsp;{{ 'environment.align.align_with'|trans({'%environment%': withEnvironment, '%with_environment%': environment}) }}</button>
                    {% endif %}
                      {% if fromInMyCircles %}
                        <button type="submit" name="compare_environment_form[alignLeft]" class="btn-danger btn-md btn"><span class="fa fa-chevron-left"></span>&nbsp;{{ 'environment.align.align_with'|trans({'%environment%': environment, '%with_environment%': withEnvironment}) }}</button>
                      {% endif %}
                  </div>
            {% endif %}

              {{ include('@EMSAdminUI/bootstrap5/elements/pagination.html.twig', {
                lastPage: lastPage,
                currentPage: page,
                currentFilters: app.request.query,
                paginationPath: paginationPath,
                showAlwaysFirstAndLast: false,
            }) }}
          </div>
          <!-- /.box-body -->
      {% endif %}
    </div>
  </div>
{% endif %}

{{ form_rest(form) }}
{{ form_end(form) }}
</div>
{% endblock %}
