{% extends '@EMSAdminUI/bootstrap5/base/admin.html.twig' %}{% trans_default_domain 'ems-adminui-twigs' %}

{% block title %}{{ 'environment.rebuild.title'|trans({'%name%': environment.name}) }}{% endblock %}
{% block pagetitle %}{{ 'environment.rebuild.title'|trans({'%name%': environment.name}) }}{% endblock %}
{% block breadcrumb %}
    <ol class="breadcrumb float-sm-end">
        <li class="breadcrumb-item"><i class="fa fa-database"></i> {{ 'environment.plural'|trans }}</li>
        <li class="breadcrumb-item"><a href={{ path('emsco_admin_environment_index') }}>{{ 'environment.index.title'|trans }}</a></li>
           <li class="breadcrumb-item active">{{ 'environment.rebuild.short_title'|trans }}</li>
       </ol>
{% endblock %}

{% block body %}
<div class="row">
    <div class="col-md-6">
        <div class="card card-warning card-outline">
            <div class="card-header">
                <h3 class="card-title"><i class="fa fa-warning"></i> {{ 'notice_card.title'|trans }}</h3>
            </div>
            <!-- /.box-header -->
            <div class="card-body">
                <p>
                    {{ 'environment.rebuild.notice'|trans }}
                </p>
            </div>
            <!-- /.box-body -->
        </div>
    </div>
    <div class="col-md-6">
        <div class="card card-{{ theme_color }} card-outline">
            <div class="card-header">
                <h3 class="card-title">{{ 'environment.rebuild.options.title'|trans }}</h3>
            </div>
            <!-- /.box-header -->
            <!-- form start -->
            {{ form_start(form) }}
                <div class="card-body">
                    {{ form_row(form.option) }}
                </div>
                <!-- /.box-body -->
                <div class="card-footer">
                    <div class="btn-group text-end">
                        {{ form_widget(form.rebuild) }}
                    </div>
                </div>
                <!-- /.box-footer -->

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
