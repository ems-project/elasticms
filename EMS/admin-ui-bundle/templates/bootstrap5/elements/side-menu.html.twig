{% trans_default_domain 'emsco-core' %}

<div class="user-panel">
    {{ include('@EMSAdminUI/bootstrap5/elements/user-image.html.twig', { width: 30, height: 30 }) }}
    <div class="info">
        {% if app.user %}
            <a href="{{ path('emsco_user_profile') }}" class="info-name">{{ app.user.displayName }}</a>
        {% else %}
            <p class="info-name">{{ 'key.anonymous_user'|trans }}</p>
        {% endif %}
        {%- if status is defined -%}
            <a href="{{ path('elasticsearch.status') }}" id="status-overview" class="info-status fs-6" data-testid="status-overview">
                {%- with {
                    title: 'cluster.status'|trans({color: status}, 'emsco-core'),
                    status: status,
                } -%}
                    {{ block('status', '@EMSAdminUI/bootstrap5/elasticsearch/status.html.twig') }}
                {%- endwith -%}
            </a>
        {%- endif -%}
    </div>
</div>

{% if app.user %}
    <div class="sidebar-search">
        <form action="{{ path('ems_quick_search') }}" method="get" class="sidebar-form">
            <div class="input-group input-group-sm">
                <label for="q" class="sr-only">{{ 'field.quick_search'|trans }}</label>
                <input type="text" class="form-control" id="q" name="q" placeholder="{{ 'message.search_placeholder'|trans }}" data-testid="search-general-query">
                <button class="btn" type="submit" name="search" id="search-btn" data-testid="search-general-submit">
                    <i class="fa-solid fa-magnifying-glass" style="font-size:.8rem"></i>
                </button>
            </div>
        </form>
    </div>
{% endif %}

{% for group in menu|default([])|filter(g => g.hasChildren) %}
    <div class="nav-label">{{ group.title|trans }}</div>
    <ul class="sidebar-menu">
        {%- for menu in group.children -%}
            {%- set menuLabel = menu.labelTranslation is not null ? menu.labelTranslation|trans : menu.label -%}
            {%- set menuRoute = menu.hasChildren ? '#' : path(menu.route, menu.routeParameters) -%}
            <li {% if menu.hasChildren %}class="treeview"{% endif %}>
                <a href="{{ menuRoute }}"
                   class="{{ html_classes({ 'menu-toggle': menu.hasChildren, ("text-#{menu.color}"): menu.color }) }}"
                   data-testid="menu-item-{{ menuLabel|ems_slug }}">
                    <span class="nav-icon"><i class="{{ menu.icon }} icon-fa"></i></span>
                    <span class="nav-text">{{ menuLabel }}</span>
                    {% if menu.hasBadge %}
                        <span class="nav-badge {{ html_classes('nav-badge', { ("bg-#{menu.badgeColor}"): menu.badgeColor }) }}">
                            {{ menu.badge }}
                        </span>
                    {% elseif menu.hasChildren %}
                        <span class="caret"><i class="fa-solid fa-angle-right" style="font-size:.75rem"></i></span>
                    {% endif %}
                </a>
                {%- if menu.hasChildren -%}
                    <ul class="treeview-menu">
                        {%- for item in menu.children -%}
                            {%- set itemLabel = item.labelTranslation is not null ? item.labelTranslation|trans : item.label -%}
                            <li>
                                <a href="{{ path(menu.route, menu.routeParameters) }}"
                                   data-testid="menu-item-{{ menuLabel|ems_slug }}-{{ itemLabel|ems_slug }}">
                                    <span class="nav-icon"><i class="{{ item.icon }} icon-fa"></i></span>
                                    <span class="nav-text">{{ itemLabel }}</span>
                                    {% if item.hasBadge %}
                                        <span class="nav-badge {{ html_classes('nav-badge', { ("bg-#{item.badgeColor}"): item.badgeColor }) }}">
                                            {{ item.badge }}
                                        </span>
                                    {% endif %}
                                </a>
                            </li>
                        {%- endfor -%}
                    </ul>
                {%- endif -%}
            </li>
        {%- endfor -%}
    </ul>
{% endfor %}