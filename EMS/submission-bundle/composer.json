{
    "name": "elasticms/submission-bundle",
    "description": "Submit data based on elasticms configurations",
    "type": "symfony-bundle",
    "keywords": [
        "elasticms"
    ],
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "EMS Community",
            "homepage": "https://github.com/ems-project/elasticms/contributors"
        }
    ],
    "require": {
        "php": "^8.5",
        "elasticms/form-bundle": "7.0.*",
        "league/flysystem-memory": "^3.19",
        "league/flysystem-sftp-v3": "^3.22",
        "symfony/console": "7.4.*",
        "symfony/event-dispatcher": "7.4.*",
        "symfony/http-client": "7.4.*",
        "symfony/options-resolver": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/mime": "7.4.*",
        "symfony/twig-bundle": "7.4.*"
    },
    "autoload": {
        "psr-4": {
            "EMS\\SubmissionBundle\\": "src/"
        }
    },
    "config": {
        "lock": false,
        "sort-packages": true
    }
}
