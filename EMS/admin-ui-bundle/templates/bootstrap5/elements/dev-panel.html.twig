<li class="nav-item dropdown" id="dev-panel">
    <a class="nav-link dropdown-toggle dev-panel-toggle" href="#" data-bs-toggle="dropdown" data-bs-auto-close="outside" title="Dev panel">
        <i class="fa fa-flask"></i>
        <span id="devBadge" class="badge navbar-badge" style="display: none;">9</span>
    </a>
    <div class="dropdown-menu dropdown-menu-end dev-panel-menu p-3" style="min-width: 240px;">
        <div class="dev-panel-label">Mode</div>
        <div class="d-flex mb-4">
            <button type="button" class="mode-btn" data-mode="light">Light</button>
            <button type="button" class="mode-btn" data-mode="dark">Dark</button>
        </div>

        <div class="dev-panel-label">Theme color (sidebar/topbar)</div>
        <div class="d-flex gap-3 mb-4">
            {% for color in ['blue', 'purple', 'green', 'red', 'yellow'] %}
                <button type="button" class="skin-swatch" data-skin="{{ color }}" title="{{ color }}"></button>
            {% endfor %}
        </div>

        <div class="dev-panel-label">Sidebar</div>
        <div class="form-check form-switch mb-4">
            <input class="form-check-input" type="checkbox" role="switch" id="devSidebarCollapsed">
            <label class="form-check-label" for="devSidebarCollapsed">Collapsed</label>
        </div>

        <div class="dev-panel-label">Badge</div>
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="devShowBadge">
            <label class="form-check-label" for="devShowBadge">Show badge on this icon</label>
        </div>
        <div class="dev-panel-label">Reset</div>
        <button type="button" class="btn btn-sm btn-outline-secondary" id="devReset">Clear overrides</button>
    </div>
</li>
