{% extends '@EMSCH/template/base/bootstrap.html.twig' %}
{% trans_default_domain trans_default_domain %}

{% import '@EMSCH/template/macros/wysiwyg.twig' as wysiwyg %}

{% block title %}{{ source.(locale).title|default('') }}{% endblock %}

{% block metatitle -%}
    {%- if source.(locale).meta_title|default(false) -%}
        {{- source.(locale).meta_title -}}
    {%- else -%}
        {{- parent() -}}
    {%- endif -%}
{%- endblock -%}

{%- block meta_description -%}
    {%- if source.(locale).description|default(false) -%}
        {{- source.(locale).description|striptags|ems_html_decode|trim -}}
    {%- else -%}
        {{- parent() -}}
    {%- endif -%}
{%- endblock -%}

{% block main -%}
    <div class="jumbotron bg-primary py-8 px-0 rounded-0 mb-0 d-flex align-items-center text-white mb-3">
        <div class="container-fluid container-lg">
            <div class="row">
                <div class="col-12 col-lg-10 offset-lg-1 col-xl-8 offset-xl-2 mb-2">
                    {% block breadcrumb %}{% endblock %}
                    <h1 {{ emsch_admin_menu(target.getEmsLink|default(emsLink|default(''))) }}>
                        {{ block('title') }}
                    </h1>
                    {{ source.(locale).summary|default('')|emsch_routing }}
                </div>
            </div>
        </div>
    </div>
    {% if source.(locale).body|default(false) %}
        <div class="container-fluid container-lg">
            <section class="py-5 py-lg-8">
                <div class="row">
                    <div class="col-12 col-lg-10 offset-lg-1 col-xl-8 offset-xl-2">
                        {{ wysiwyg.transform(source.(locale).body|emsch_routing) }}
                    </div>
                </div>
            </section>
        </div>
    {% endif %}

    {% block blocks %}{% endblock %}
{%- endblock main %}
