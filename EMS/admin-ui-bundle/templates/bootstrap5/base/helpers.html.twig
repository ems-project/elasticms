{% macro attributes(attr, extra = {}) -%}
    {%- set classes = [] -%}
    {%- for source in [attr, extra] -%}
        {%- set value = source.class|default([]) -%}
        {%- set classes = classes|merge(value is iterable ? value : value|split(' ')) -%}
    {%- endfor -%}
    {%- set attr = attr|merge(extra) -%}
    {%- set classes = classes|filter(c => c is not empty)|join(' ') -%}
    {%- if classes is not empty -%}
        {%- set attr = attr|merge({class: classes}) -%}
    {%- endif -%}
    {%- for name, value in attr -%}
        {%- if value is same as(true) -%}
            {{- ' ' ~ name }}
        {%- elseif value is not same as(false) and value is not null -%}
            {{- ' ' ~ name }}="{{ value|e('html_attr') }}"
        {%- endif -%}
    {%- endfor -%}
{%- endmacro %}
