{% extends '@EMSAdminUI/bootstrap5/base/admin.html.twig' %}{% trans_default_domain 'emsco-core' %}

{% block title %}{{ 'environment.add.title'|trans }}{% endblock %}
{% block pagetitle %}{{ 'environment.add.title'|trans }}{% endblock %}

{% block body %}

<div class="row">
    <div class="col-md-6">
        <div class="card card-warning card-outline">
            <div class="card-header">
                <h3 class="card-title"><i class="fa fa-warning"></i> {{ 'notice_card.title'|trans }}</h3>
            </div>
            <!-- /.box-header -->
            <div class="card-body">
                <p>
                    {{ 'environment.add.notice'|trans }}
                </p>
            </div>
            <!-- /.box-body -->
        </div>
    </div>
    <div class="col-md-6">
        <!-- general form elements -->
        <div class="card card-{{ theme_color }} card-outline">
            <div class="card-header">
                <h3 class="card-title">{{ 'environment.add.short_title'|trans }}</h3>
            </div>
            <!-- /.box-header -->
            <!-- form start -->
            {{ form_start(form) }}
                <div class="card-body">
                    {{ form_row(form.name) }}
                    {{ form_row(form.color) }}
{# {{ form_row(form.managed) }} #}
                </div>
                <!-- /.box-body -->
                <div class="card-footer">
                    {{ form_widget(form.save) }}
                </div>
            {{ form_end(form) }}

        </div>
        <!-- /.box -->
    </div>
</div>
{% endblock %}
