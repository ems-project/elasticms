{%- trans_default_domain 'emsco-core' -%}
<div class="offcanvas offcanvas-end bg-dark" tabindex="-1" id="control-sidebar" aria-labelledby="control-sidebar-label">
    <div class="offcanvas-header visually-hidden">
        <h5 class="offcanvas-title" id="control-sidebar-label">{{ 'key.control_sidebar'|trans }}</h5>
    </div>
    <div class="offcanvas-body p-0">
        <div class="tabs-dark d-flex flex-column flex-grow-1 h-100">
            <ul class="nav nav-tabs nav-fill" id="custom-tabs-two-tab" role="tablist">
                <li class="nav-item">
                    <a title="{{ 'key.recent_activities'|trans|e('html_attr') }}" class="nav-link active" id="control-sidebar-home-tab-label" data-bs-toggle="pill"  href="#" data-bs-target="#control-sidebar-home-tab" role="tab" aria-controls="control-sidebar-home-tab" aria-selected="true">
                        <i class="fa fa-home"></i><span class="visually-hidden">{{ 'key.recent_activities'|trans }}</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a title="{{ 'key.last_commands'|trans|e('html_attr') }}" class="nav-link" id="control-sidebar-jobs-tab-label" data-bs-toggle="pill" href="#" data-bs-target="#control-sidebar-jobs-tab" role="tab" aria-controls="control-sidebar-jobs-tab" aria-selected="false">
                        <i class="fa fa-terminal"></i><span class="visually-hidden">{{ 'key.last_commands'|trans }}</span>
                    </a>
                </li>
            </ul>
            <div class="tab-content" id="control-sidebar-tab-content">
                <div class="tab-pane fade dark show active" id="control-sidebar-home-tab" role="tabpanel" aria-labelledby="control-sidebar-home-tab-label">
                    <h3 class="control-sidebar-heading h4">{{ 'key.recent_activities'|trans }}</h3>
                    <ul class="control-sidebar-menu" id="activity-log">
                    </ul>
                </div>
                <div class="tab-pane fade dark" id="control-sidebar-jobs-tab" role="tabpanel" aria-labelledby="custom-tabs-two-profile-label">
                    <h3 class="control-sidebar-heading h4">{{ 'key.last_commands'|trans }}</h3>
                    <ul class="control-sidebar-menu" id="commands-log">
                        {% if app.user %}
                            {{ render(controller('EMS\\CoreBundle\\Controller\\TwigElementsController::jobs', {
                                username: app.user.username,
                            })) }}
                        {% endif %}
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
