{%- trans_default_domain 'emsco-core' -%}

<nav class="navbar navbar-expand navbar-fixed">
    <a href="{{ path('homepage') }}" class="navbar-brand">
        <span class="align-middle">{{ ems_name|raw }}</span>
    </a>
    <div class="navbar-toolbar">
        <a href="#" class="sidebar-toggle js-sidebar-toggle" data-widget="pushmenu" role="button" aria-label="{{ 'key.push_menu'|trans }}">
            <i class="fa fa-bars"></i>
        </a>
        <div class="navbar-collapse collapse">
            <ul class="navbar-nav navbar-align">
                {% if app.user %}
                    {%- set channels = this.channels|default([]) -%}
                    {%- if channels|default([])|length > 0 -%}
                        <li class="nav-item dropdown">
                            <a class="nav-link" data-bs-toggle="dropdown" href="#">
                                <i class="fa fa-eye"></i>
                                <span class="visually-hidden">{{ 'key.channels'|trans({}, 'emsco-core') }}</span>
                            </a>
                            <div class="dropdown-menu dropdown-menu-end">
                                {%- set homepage = path('homepage') -%}
                                {%- for channel in channels -%}
                                    <a href="{{ channel.getEntryPath(homepage) }}" target="_blank" class="dropdown-item">
                                        <i class="fa fa-{{ channel.public|default ? 'unlock-alt' : 'lock' }} me-2"></i>
                                        {{ channel.label }}
                                    </a>
                                {%- endfor -%}
                            </div>
                        </li>
                    {%- endif -%}

                    {%- for dashboard in this.dashboards.children|default([]) -%}
                        <li class="nav-item">
                            <a href="{{ path(dashboard.route, dashboard.routeParameters) }}" class="nav-link{% if dashboard.color %} text-{{ dashboard.color }}{% endif %}">
                                <i class="{{ dashboard.icon }}"></i>
                            </a>
                        </li>
                    {%- endfor -%}

                    <li class="nav-item">
                        <a href="{{ path('notifications.inbox') }}" class="nav-link" title="{{ 'key.notifications'|trans({}, 'emsco-core') }}">
                            <i class="fa fa-envelope"></i>
                            {%- if this.countNotifications > 0 -%}
                                <span class="navbar-badge badge text-bg-warning">{{ this.countNotifications }}</span>
                            {%- endif -%}
                        </a>
                    </li>

                {% endif %}

                <li class="nav-item" id="system-messages">
                    <a class="nav-link" data-bs-toggle="offcanvas" href="#control-sidebar" role="button" aria-controls="control-sidebar">
                        <i id="ajax-activity" class="fa fa-refresh"></i>
                        <span class="visually-hidden">{{ 'action.toggle_sidebar'|trans }}</span>
                        <span id="activity-counter" class="badge navbar-badge"></span>
                    </a>
                </li>
                {% if is_granted('ROLE_SUPER_ADMIN') %}
                    {{ include('@EMSAdminUI/bootstrap5/elements/dev-panel.html.twig') }}
                {% endif %}
                {% if app.user %}
                    <li class="nav-item dropdown user-menu" data-testid="user-menu">
                        <a class="nav-link dropdown-toggle justify-content-center" href="#" data-bs-toggle="dropdown">
                            {{ include('@EMSAdminUI/bootstrap5/elements/user-image.html.twig', {
                                class: 'rounded-circle avatar-sm img-fluid',
                                width: 24,
                                height: 24,
                            }) }}
                            <span class="d-none d-sm-inline ms-2">{{ app.user.username }}</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end pt-0">
                            <li class="user-header p-2">
                                <div class="text-center">
                                    {{ include('@EMSAdminUI/bootstrap5/elements/user-image.html.twig', {
                                        class: 'rounded-circle',
                                        width: 60,
                                        height: 60,
                                    }) }}
                                </div>

                                <p class="text-white text-center mt-2 mb-0">
                                    {{ 'message.logged_in_as'|trans({'username': app.user.username}, 'emsco-core') }}
                                    <small>{{ 'message.member_since'|trans({'date': app.user.created|date(date_time_format)}, 'emsco-core') }}</small>

                                    <small class="d-block">
                                        {% for role in app.user.roles %}
                                            {{ (role|replace({'ROLE_': 'ROLE.'}) ~ '.label')|lower|trans([], 'emsco-core') }}{% if not loop.last %},{% endif %}
                                        {% endfor %}
                                    </small>
                                </p>
                            </li>
                            <li class="pt-2">
                                <a href="{{ path(routes.USER_PROFILE) }}" class="dropdown-item"><i class="fa fa-user"></i> {{ 'title.profile'|trans({}, 'emsco-core') }}</a>
                            </li>
                            {% if is_granted('IS_IMPERSONATOR') %}
                                <li>
                                    <a href="{{ path('emsco_user_index', {_switch_user: '_exit'}) }}" class="dropdown-item" data-testid="logout"><i class="fa fa-sign-out" aria-hidden="true"></i> {{ 'action.exit'|trans({}, 'emsco-core') }}</a>
                                </li>
                            {% else %}
                                <li>
                                    <a href="{{ path(routes.USER_LOGOUT) }}" class="dropdown-item" data-testid="logout"><i class="fa fa-sign-out" aria-hidden="true"></i> {{ 'action.sign_out'|trans({}, 'emsco-core') }}</a>
                                </li>
                            {% endif %}
                        </ul>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>
