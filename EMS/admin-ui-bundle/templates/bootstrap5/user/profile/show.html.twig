{% extends '@EMSAdminUI/bootstrap5/template/card.html.twig' %}
{%- trans_default_domain 'emsco-core' -%}

{% block body %}
    {% set footer %}
        <div class="btn-group">
            <a href="{{ path(routes.USER_PROFILE_EDIT) }}" class="btn btn-primary"><i class="fa fa-pencil"></i> {{ 'user.profile.show.action.edit'|trans }}</a>
            <a href="{{ path(routes.USER_CHANGE_PASSWORD) }}" class="btn btn-primary"><i class="fa fa-lock"></i> {{ 'user.profile.change_password.title'|trans }}</a>
        </div>
    {% endset %}
    <div class="row justify-content-md-center">
        <div class="col-md-6">
            {{ parent() }}
        </div>
    </div>
{% endblock body %}

{% block content %}
        <div class="text-center">
            {{ include('@EMSAdminUI/bootstrap5/elements/user-image.html.twig', {
                class: 'profile-user-img img-responsive rounded-circle',
            }) }}
        </div>

        <h3 class="profile-username text-center">{{ user.displayName }}</h3>

        {% if user.group %}
            <p class="text-muted text-center">{{ user.group.label }}</p>
        {% endif %}

    {% set emailNotification %}
        <i class="float-end fa-regular fa-2x {{ html_classes('a-class', 'another-class', {
            'fa-check-square': user.emailNotification,
            'fa-square': not user.emailNotification,
        }) }}"></i>
    {% endset %}
    {% set simplifiedUI %}
        <i class="float-end fa-regular fa-2x {{ html_classes('a-class', 'another-class', {
            'fa-check-square': attribute(user.userOptions, 'simplified_ui'),
            'fa-square': not attribute(user.userOptions, 'simplified_ui'),
        }) }}"></i>
    {% endset %}
    {% set circles %}
        {% for circle in user.circles|default([]) -%}
            <span class="badge bg-primary text-nowrap">{{- circle|emsco_display|raw -}}</span>
        {%- endfor %}
    {% endset %}
    {% set roles %}
        <div class="d-flex flex-wrap gap-2 mt-2">
            {% for role in user.userRoles|default([]) %}
                <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 fw-semibold">
                  {{ role|replace({'ROLE_': 'ROLE.'})|lower|trans([], 'emsco-core') }}
              </span>
            {% endfor %}
        </div>
    {% endset %}

    {% set items = [
        {icon: 'fas fa-user', label: 'user.profile.show.username'|trans, value: user.displayName},
        {icon: 'fas fa-envelope', label: 'user.profile.show.email'|trans, value: user.email},
        {icon: 'fas fa-bell', label: 'user.profile.show.email_notification'|trans, value: emailNotification},
        {icon: 'fas fa-person-walking-with-cane', label: 'user.option.simplified_ui'|trans, value: simplifiedUI},
        {icon: 'fas fa-language', label: 'user.profile.show.locale'|trans, value: user.locale|language_name},
        {icon: 'fas fa-house-flag', label: 'user.profile.show.locale_preferred'|trans, value: user.localePreferred|language_name},
        {icon: 'fa-solid fa-pen-to-square', label: 'user.profile.show.wysiwyg'|trans, value: user.wysiwygProfile.name|default('')},
    ] %}

    {% if circles_object and circles_object|emsco_get_content_type %}
        {% set items = items|merge([
            {icon: 'fa-regular fa-circle-dot', label: circles_object|emsco_get_content_type.pluralName, content: circles},
        ]) %}
    {% endif %}

    {% if user.userRoles|default([])|length > 0 %}
        {% set items = items|merge([
            {icon: 'fa-solid fa-id-card-clip', label: 'user.profile.show.extra_roles'|trans, content: roles},
        ]) %}
    {% endif %}

    {{ include('@EMSAdminUI/bootstrap5/core/list-group.html.twig', {list: items}) }}
{% endblock content %}
