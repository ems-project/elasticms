{% extends 'bootstrap_4_layout.html.twig' %}

{% block form_row -%}
    {% if ems_meta.rules|default([])|length > 0 %}
        {% set row_attr = row_attr|merge({
            'data-rules': ems_meta.rules|json_encode,
            'data-show-hide': ems_meta.show_hide|default('show'),
            'data-all-any': ems_meta.all_any|default('any'),
        }) %}
    {%  endif %}
    {{ parent() }}
{% endblock  %}

{% block checkbox_row -%}
    {% if ems_meta.rules|default([])|length > 0 %}
        {% set row_attr = row_attr|merge({
            'data-rules': ems_meta.rules|json_encode,
            'data-show-hide': ems_meta.show_hide|default('show'),
            'data-all-any': ems_meta.all_any|default('any'),
        }) %}
    {%  endif %}
    {%- if compound is defined and compound -%}
        {%- set element = 'fieldset' -%}
    {%- endif -%}
    {%- set widget_attr = {} -%}
    {%- if help is not empty -%}
        {%- set widget_attr = {attr: {'aria-describedby': id ~"_help"}} -%}
    {%- endif -%}
    <{{ element|default('div') }}{% with {attr: row_attr|merge({class: (row_attr.class|default('') ~ ' form-group')|trim})} %}{{ block('attributes') }}{% endwith %}>
    {{- form_label(form) -}}
    {{- form_widget(form, widget_attr) -}}
    {{- form_help(form) -}}
    </{{ element|default('div') }}>
{% endblock  %}


{% block button_row -%}
    {% if ems_meta.rules|default([])|length > 0 %}
        {% set row_attr = row_attr|merge({
            'data-rules': ems_meta.rules|json_encode,
            'data-show-hide': ems_meta.show_hide|default('show'),
            'data-all-any': ems_meta.all_any|default('any'),
        }) %}
    {%  endif %}
    {{ parent() }}
{%- endblock %}

{% block ems_markup_row -%}
    {% set attr = attr|merge({
        'class': 'form-group',
    }) %}
    {% if config.meta.rules|default([])|length > 0 %}
        {% set attr = attr|merge({
            'data-rules': config.meta.rules|json_encode,
            'data-show-hide': config.meta.show_hide|default('show'),
            'data-all-any': config.meta.all_any|default('any'),
        }) %}
    {%  endif %}
    <div {{ block('attributes') }}>
        {{ form.vars.config.markup|emsch_routing }}
    </div>
{%- endblock %}


{% block ems_file_row %}
    <div class="form-group">
        <div class="files-upload border rounded">
            {%- set browseLabel = "#{name}_browse"|trans -%}
            {%- if "#{name}_browse" == browseLabel -%}
                {%- set browseLabel = "ems_file_browse"|trans -%}
            {%- endif -%}
            {%- set label_attr = {
                'data-browse': browseLabel,
                'placeholder': label_attr.placeholder|default(form.vars.label|default(none))
            } -%}
            {{- form_widget(form, {label_attr: label_attr}) -}}
            {{- form_help(form) -}}
            <ul class="file-list"></ul>
        </div>
    </div>
{% endblock %}

{% block file_widget -%}
    <{{ element|default('div') }} class="custom-file">
    {%- set type = type|default('file') -%}
    {%- set input_lang = 'en' -%}
    {% if app is defined and app.request is defined %}{%- set input_lang = app.request.locale -%}{%- endif -%}
    {%- set attr = {lang: input_lang} | merge(attr) -%}
    {{- block('form_widget_simple') -}}
    {%- set label_attr = label_attr|merge({ class: (label_attr.class|default('') ~ ' custom-file-label')|trim })|filter((value, key) => key != 'id') -%}
    {% set label_attr = label_attr|merge({
        'class': label_attr.class|default('') ~ ' ' ~ ems_meta.class|default(''),
    }) %}
    <label for="{{ form.vars.id }}" {% with { attr: label_attr } %}{{ block('attributes') }}{% endwith %}>
       {{ label|raw }}
    </label>
    </{{ element|default('div') }}>
{% endblock -%}

{% block repeated_row -%}
    {% if ems_meta.rules|default([])|length > 0 %}
        {% set row_attr = row_attr|merge({
            'data-rules': ems_meta.rules|json_encode,
            'data-show-hide': ems_meta.show_hide|default('show'),
            'data-all-any': ems_meta.all_any|default('any'),
        }) %}
    {% endif %}
    {{ form_row(form.first, { 'attr': {'class': ems_meta.class|default('')}, row_attr: row_attr  }) }}
    {{ form_row(form.second, { 'attr': {'class': ems_meta.class|default('')}, row_attr: row_attr  }) }}
{% endblock -%}
