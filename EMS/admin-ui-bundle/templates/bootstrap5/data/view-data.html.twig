{% extends '@EMSAdminUI/bootstrap5/base/admin.html.twig' %}{% trans_default_domain 'emsco-core' %}

{% block title %}{{ 'data.view.recursive.title'|trans({'%content_type%': object._source._contenttype, '%id%': object._id}) }}{% endblock %}
{% block pagetitle %}
    <i class="{% if contentType and contentType.icon %}{{ contentType.icon }} {% else %} fa fa-question {% endif %} "></i>
    {{ object._source._contenttype|humanize }} :

    {% set title = document|emsco_display %}
    {% if title != object._id %}
        {{ title }} <small>{{ object._id }}</small>
    {% else %}
        {{ object._id }}
    {% endif %}
    {{ 'data.view.recursive.as_indexed_in'|trans }}
    <span class="badge bg-{{ environment.color|raw }}">{{ environment.label }}</span>
{% endblock %}

{% block subtitle %}{% endblock %}

{% block body %}
    <div class="row raw-view">
        <div class="col-12">
            <div class="card card-{{ theme_color }} card-outline card-outline-tabs">
                <div class="card-header">
                    <h3 class="card-title">{{ 'data.view.recursive.card_title'|trans }}</h3>
                </div>
                <div class="card-body">
                    <pre class="ems-code-editor" data-language="ace/mode/json"
                         data-theme="ace/theme/chrome" data-max-lines="500">{{ object|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                </div>
                <!-- /.box-body -->
                <div class="card-footer">
                    {{ include('@EMSAdminUI/bootstrap5/elements/object-toolbar.html.twig', {
                        object: object,
                        contentType: contentType,
                        recursiveView: true,
                    }) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
