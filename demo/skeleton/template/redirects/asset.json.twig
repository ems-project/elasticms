{%- set hash = app.request.attributes.get('hash') -%}
{%- set filename = app.request.attributes.get('filename') -%}
{%- set config = app.request.attributes.get('config') -%}
{%- set search = emsch_search([], {
    "query": {
        "match_phrase": {
            "_all": hash,
        }
    },
}, 0, 0) -%}

{%- if search.hits.total.value|default(0) == 0 -%}
    {%- set head = ems_asset_head(hash) -%}
    {% do emsch_http_error(head ? 403 : 404) -%}
{%- endif -%}

{{- {
    controller: 'EMS\\CommonBundle\\Controller\\FileController::asset',
    path: {
       filename: filename,
       hash: hash,
       hash_config: config,
    },
}|json_encode|raw -}}
