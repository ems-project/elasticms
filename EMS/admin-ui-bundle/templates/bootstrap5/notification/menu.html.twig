{% trans_default_domain 'emsco-core' %}

{% for dashboard in dashboardMenu.children %}
    <button class="nav-link nav-icon-btn {% if dashboard.color %} text-{{ dashboard.color }}{% endif %}">
        <i class="{{ dashboard.icon }} icon-fa"></i>
    </button>
{% endfor %}

<a href="{{ path('notifications.inbox') }}" class="nav-link nav-icon-btn" aria-label="{{ 'key.notifications'|trans }}">
    <i class="fa-solid fa-envelope icon-fa"></i>
    {% if counter > 0 %}
        <span class="badge-dot">{{ counter }}</span>
    {% endif %}
</a>
