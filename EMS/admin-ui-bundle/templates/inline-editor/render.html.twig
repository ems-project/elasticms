{%- block actions -%}
    <button type="button" class="btn btn-sm btn-primary" data-editor-action="publish">
        Publish
    </button>
    <button type="button" class="btn btn-sm btn-outline-primary" data-editor-action="save">
        Save
    </button>
    <button type="button" class="btn btn-sm btn-outline-warning" data-editor-action="discard">
        Discard
    </button>
{%- endblock actions -%}

{%- block edit -%}
    <div class="py-3 px-2 fw-bold bg-white border-bottom text-primary">
        <i class="fas fa-pencil fa-xs me-2"></i>Editing
    </div>
    <div class="bg-white py-3 px-3">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="fw-bold text-dark small">
                <i class="fas fa-file-alt text-muted me-2"></i>{{ info.label }}
            </span>
        </div>
        <div class="d-flex justify-content-between x-small mb-1">
            <span class="text-muted small">Element</span>
            <span class="text-dark small fw-medium">{{ element.path }}</span>
        </div>
    </div>
{%- endblock edit -%}

{%- block elements -%}
    {%- if infos|length > 0 or editing_element -%}
        <div class="py-3 px-2 fw-bold bg-white border-bottom text-primary">
            <i class="fas fa-tags fa-xs me-2"></i>Elements
        </div>
        <div class="list-group list-group-flush border-bottom">
            {%- for info in infos -%}
                <div class="list-group-item py-3 px-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold text-dark small">
                            <i class="fas fa-file-alt text-muted me-2"></i>{{ info.label }}
                        </span>
                    </div>
                    <div>
                        <div class="d-flex justify-content-between x-small mb-1">
                            <span class="text-muted small">Type</span>
                            <span class="text-dark small fw-medium">{{ info.contentType.singularName }}</span>
                        </div>
                        {% for env, status in info.status %}
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="text-muted small text-capitalize">{{ env }}</span>
                                <span class="badge {{ html_classes('', {
                                    'text-success': status === 'published',
                                    'text-warning': status === 'outdated',
                                    'text-danger': status === 'not_published'
                                }) }} p-0 bg-transparent fw-bold" style="font-size: 0.75rem;">
                                    {% if status == 'published' %}<i class="fas fa-check-circle me-1"></i>{% endif %}
                                    {{ status|replace({'_': ' '}) }}
                                </span>
                            </div>
                        {% endfor %}

                        {% if info.elements|length > 0 %}
                            <div class="mt-3 p-2 bg-light rounded border-start border-3 border-info">
                                <p class="x-small fw-bold mb-1 text-uppercase text-muted" style="font-size: 0.7rem;">Elements</p>
                                <ul class="list-unstyled mb-0 small text-break">
                                    {%- for element in info.elements -%}
                                        <li class="text-muted mb-1">
                                            <i class="fas fa-tag fa-xs me-1 text-info"></i> {{ element.path }}
                                        </li>
                                    {%- endfor -%}
                                </ul>
                            </div>
                        {% endif %}
                    </div>
                </div>
            {%- endfor -%}
        </div>
    {%- endif -%}
{%- endblock elements -%}




