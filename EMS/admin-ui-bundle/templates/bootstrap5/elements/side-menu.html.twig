{%- trans_default_domain 'elements' -%}

<div class="user-panel my-3 d-flex">
    <div class="image">
        {{ include('@EMSAdminUI/bootstrap5/elements/user-image.html.twig', {
            class: 'rounded-circle avatar ms-3 img-fluid',
            width: 37,
            height: 37
        }) }}
    </div>
    <div class="info ms-3">
        {% if not app.user %}
            <div class="dropdown user-menu">
                <a class="dropdown-toggle text-white" href="#" data-bs-toggle="dropdown">
                    {{ app.user.displayName }}
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li class="dropdown-header">{{ 'user.logged_in.title'|trans({'%username%': app.user.username}, 'emsco-user') }}</li>
                    <li class="dropdown-divider"></li>
                    <li>
                        <a href="{{ path(routes.USER_PROFILE) }}" class="dropdown-item">{{ 'user.profile.title'|trans({}, 'emsco-user') }}</a>
                    </li>
                    <li>
                        {% if is_granted('IS_IMPERSONATOR') %}
                            <a href="{{ path('emsco_user_index', {_switch_user: '_exit'}) }}" class="dropdown-item">{{ 'user.logout.exit'|trans({}, 'emsco-user') }}</a>
                        {% else %}
                            <a href="{{ path(routes.USER_LOGOUT) }}" class="dropdown-item">{{ 'user.logout.submit'|trans({}, 'emsco-user') }}</a>
                        {% endif %}
                    </li>
                </ul>
            </div>
        {% else %}
            <p class="text-white mb-0">{{ 'side_menu.anonymous-user'|trans }}</p>
        {% endif %}
        {% if status is defined %}
            {% set statusTitle = 'cluster.status'|trans({color: status}, 'emsco-core') %}
            <a href="{{ path('elasticsearch.status') }}" id="status-overview" title="{{ statusTitle }}">
                {%- with {
                    title: statusTitle,
                    status: status,
                } -%}
                    {{ block('status', '@EMSAdminUI/bootstrap5/elasticsearch/status.html.twig') }}
                {%- endwith -%}
            </a>
        {% endif %}
    </div>
</div>

<ul class="sidebar-nav">
    {% for item in menu|default([])|filter(p => p.hasChildren) %}
        <li class="sidebar-header">{{ item.title|trans(item.transParameters, 'emsco-twigs') }}</li>
        {% for menu in item.children %}
            {{ block('sidebarMenu', '@EMSAdminUI/bootstrap5/elements/menu.html.twig') }}
        {% endfor %}
    {% endfor %}
</ul>
