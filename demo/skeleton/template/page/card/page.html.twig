{% block card %}
    {{ block('description') }}
    <div class="mt-5">
        <a href="{{ path('emsch_path', {path: pathsByUids.(target.source.menu).path|default('')}) }}" class="btn btn-outline-primary text-uppercase">
            {{ target.source.(locale).subtitle|default(target.source.(locale).title) }}
        </a>
    </div>
{% endblock card %}

{% block tags %}
    {% for tag in target.source.categories|default([]) %}
        {% set category = tag|emsch_get|default(false) %}
        {% if category and category.source.(locale).title|default(false) %}
            <div class="tag">{{ category.source.(locale).title }}</div>
        {% endif %}
    {% endfor %}
{% endblock tags %}

{% block description %}
    {% if target.source.(locale).title|default(false) %}
        <h3 class="h2 news-heading">{{ target.source.(locale).title }}</h3>
    {% endif %}
    {{ target.source.(locale).description|default('')|emsch_routing }}
{% endblock description %}


{% block image %}
    {% if target.source.(locale).image|default(false) %}
        {%- set imageSrc = ems_asset_path(target.source.(locale).image, {
            _config_type: 'image',
            _width: 490,
            _height: 300,
            _quality: 90,
            _resize: 'smartCrop',
            _image_format:'webp',
        }) -%}
        <img class="news-image img-fluid rounded mx-auto"
             data-src="{{ imageSrc }}"
             src="{{ imageSrc }}"
             alt="490x300"
             data-holder-rendered="true">
    {% endif %}
{% endblock image %}
